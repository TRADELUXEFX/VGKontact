<?xml version="1.0" encoding="utf-8"?>
<!--
    Cardstack redesign - approved direction #2 from the 3-option preview.

    Same view IDs and same data as the previous revision; only the visual
    shape changed:
      - Header is now a full gradient hero block (header_gradient, already
        existed, just extended taller) instead of a flat header that
        handed off directly into a plain body.
      - statsCard (the sync-progress swap container - see
        MainMenuActivity.loadStats/statsProgressBar/statsContent) now sits
        as a floating white card with a negative top margin so it visually
        overlaps the bottom of the header gradient, Material "elevated
        card" style, instead of sitting flush below it in the body
        section.
      - The old 3-row hairline-divided viewers block (limitBlock) is
        replaced by 3 equal-width side-by-side tiles inside statsCard.
        Same 5 TextViews inside (freeViewersCurrentText/MaxText,
        purchasedViewersCurrentText/MaxText, referredViewersCountText) -
        MainMenuActivity.loadViewersBlock() needs no changes.
      - syncKontactButton moved from inside the old limitBlock to directly
        inside statsCard, right under the 3 tiles, same as before
        structurally (it was always a statsCard descendant).
      - Root is still a FrameLayout for the same reason as before: the
        floating bottom_nav_bar pill needs to sit on top of the scrollable
        content, not in-flow.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/apk/res-android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/stats_card_fill">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="88dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- clipChildren/clipToPadding both false: statsCard below
             overlaps the header above it via a negative top margin.
             LinearLayout clips children to their own layout bounds by
             default, which would silently cut off exactly that
             overlap - the card would render flush against the header
             instead of floating over it, with no error to show for
             it. -->

        <!-- ================= HEADER (gradient hero) ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/header_gradient"
            android:paddingTop="48dp"
            android:paddingBottom="46dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/profileIcon"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:padding="22dp"
                    android:src="@drawable/ic_profile"
                    app:tint="@color/vg_green"
                    android:background="@color/white"
                    android:scaleType="fitCenter"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackgroundBorderless"
                    app:shapeAppearanceOverlay="@style/CircleImageShape" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <!-- Shows the user's username (UserPrefs.getName), not
                         their phone number - the phone number lives in
                         the referral code row below. Id kept as
                         phoneNumberText to minimize Kotlin churn. -->
                    <TextView
                        android:id="@+id/phoneNumberText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.01"
                        android:textColor="@color/white"
                        android:fontFamily="@font/poppins"
                        tools:text="Jay" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/group_badge_background"
                            android:paddingStart="8dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp">

                            <View
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/badge_dot" />

                            <TextView
                                android:id="@+id/planPreviewText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textAllCaps="true"
                                android:letterSpacing="0.04"
                                android:textColor="@color/white"
                                android:fontFamily="@font/poppins"
                                tools:text="FREE PLAN" />

                        </LinearLayout>

                        <!-- Alarm icon shortcut to the sync-frequency
                             preview popup - see
                             MainMenuActivity.showSyncFrequencyPopup(). -->
                        <ImageView
                            android:id="@+id/syncFrequencyAlarmIcon"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:padding="4dp"
                            android:layout_marginStart="8dp"
                            android:src="@drawable/ic_alarm"
                            app:tint="@color/white"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?android:attr/selectableItemBackgroundBorderless" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Notification bell -->
                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp">

                    <ImageView
                        android:id="@+id/notificationIcon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="12dp"
                        android:src="@drawable/ic_notification_bell"
                        android:background="@drawable/notification_circle_background"
                        android:clickable="true"
                        android:focusable="true"
                        app:tint="@color/white" />

                    <!-- Red dot shown when ActivityLog.hasUnread() is true;
                         see MainMenuActivity.renderNotificationDot(). Hidden
                         by default so it never flashes on first layout pass. -->
                    <View
                        android:id="@+id/notificationUnreadDot"
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="3dp"
                        android:layout_marginEnd="3dp"
                        android:background="@drawable/notification_unread_dot"
                        android:visibility="gone" />

                </FrameLayout>

                <!-- "Delete My Contacts" / "Resume Syncing" toggle. Icon
                     and content-description swap at runtime in
                     MainMenuActivity.renderSyncPauseButton(). -->
                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp">

                    <ImageView
                        android:id="@+id/deleteContactsIcon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="12dp"
                        android:src="@drawable/ic_delete"
                        android:background="@drawable/notification_circle_background"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="@string/menu_delete_contacts"
                        app:tint="@color/white" />

                </FrameLayout>

            </LinearLayout>

            <!-- Referral code row - shows the user's WhatsApp number as
                 their referral code, with a Copy action. Text set at
                 runtime from UserPrefs.getWhatsapp(). -->
            <LinearLayout
                android:id="@+id/referralCodeRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/header_tab_track_background"
                android:paddingStart="14dp"
                android:paddingEnd="8dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/referralCodeLabelText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="11sp"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    tools:text="Referral code: 08108709625" />

                <Button
                    android:id="@+id/copyReferralCodeButton"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/btn_copy"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/vg_green_dark"
                    android:backgroundTint="@color/white"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="14dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Permission health banner - unchanged id/logic; sits below the
             header/statsCard overlap zone. -->
        <LinearLayout
            android:id="@+id/permissionWarningBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/permission_banner_background"
            android:padding="14dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="20dp"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/permissionWarningIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_battery"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/permissionWarningText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                tools:text="Contacts permission is off - Sync is disabled" />

            <TextView
                android:id="@+id/permissionWarningAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FIX"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:paddingStart="10dp"
                android:paddingEnd="4dp" />

        </LinearLayout>

        <!-- Update available banner - unchanged. -->
        <LinearLayout
            android:id="@+id/updateAvailableBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/permission_banner_background"
            android:padding="14dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_notification_bell"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/updateAvailableText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                tools:text="A new version of VGKontact is available" />

            <TextView
                android:id="@+id/updateAvailableAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UPDATE"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:paddingStart="10dp"
                android:paddingEnd="4dp" />

        </LinearLayout>

        <!-- ================= BODY ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <!-- Sync stats card - a floating card overlapping the header
                 gradient, Material "elevated card" look. The header
                 above ends with 46dp of bottom padding specifically so
                 there is real green space for this card to pull up
                 into: -70dp here rises past that 46dp and about 24dp
                 further into the gradient itself, which is what
                 actually produces the overlap (a margin that only
                 cancels the header's own padding would just leave the
                 card flush against it, not floating over it). Same
                 3-way visibility swap as before: statsProgressBar shown
                 while loading, then swapped for statsContent - see
                 MainMenuActivity.loadStats(). -->
            <LinearLayout
                android:id="@+id/statsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-70dp"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:elevation="10dp"
                android:outlineProvider="background"
                android:padding="20dp">

                <ProgressBar
                    android:id="@+id/statsProgressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/statsContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginBottom="18dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_sync"
                            app:tint="@color/vg_green" />

                        <TextView
                            android:id="@+id/statsTodayText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/vg_dark"
                            tools:text="3 kontacts synced today" />

                    </LinearLayout>

                    <!-- ===== Viewers block: 3 equal-width tiles =====
                         Same 5 TextViews as the previous hairline-row
                         version (freeViewersCurrentText/MaxText,
                         purchasedViewersCurrentText/MaxText,
                         referredViewersCountText), just laid out as
                         side-by-side tiles instead of stacked rows.
                         MainMenuActivity.loadViewersBlock() writes to
                         these ids with no changes needed.

                         Id kept as limitBlock (unrelated to its old
                         "CONTACT LIMIT" label/meter, both long gone) -
                         MainMenuActivity.showDashboardTourIfNeeded()
                         targets it directly so the coach-mark highlight
                         covers just this tile row, not the whole
                         statsCard (which also wraps syncKontactButton
                         beneath it). -->
                    <LinearLayout
                        android:id="@+id/limitBlock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Free viewers tile -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/viewer_tile_background"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">

                            <View
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:layout_marginBottom="6dp"
                                android:background="@drawable/viewers_dot_green" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="bottom">

                                <TextView
                                    android:id="@+id/freeViewersCurrentText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    android:fontFamily="@font/poppins"
                                    android:textColor="@color/vg_dark"
                                    tools:text="3" />

                                <TextView
                                    android:id="@+id/freeViewersMaxText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_muted"
                                    tools:text="/5" />

                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/label_free_viewers"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_secondary"
                                android:gravity="center" />

                        </LinearLayout>

                        <!-- Purchased viewers tile -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/viewer_tile_background"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">

                            <View
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:layout_marginBottom="6dp"
                                android:background="@drawable/viewers_dot_blue" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="bottom">

                                <TextView
                                    android:id="@+id/purchasedViewersCurrentText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    android:fontFamily="@font/poppins"
                                    android:textColor="@color/vg_dark"
                                    tools:text="0" />

                                <TextView
                                    android:id="@+id/purchasedViewersMaxText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_muted"
                                    tools:text="/0" />

                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/label_purchased_viewers"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_secondary"
                                android:gravity="center" />

                        </LinearLayout>

                        <!-- Referred viewers tile -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/viewer_tile_background"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">

                            <View
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:layout_marginBottom="6dp"
                                android:background="@drawable/viewers_dot_amber" />

                            <TextView
                                android:id="@+id/referredViewersCountText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/poppins"
                                android:textColor="@color/vg_dark"
                                tools:text="2" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/label_referred_viewers"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_secondary"
                                android:gravity="center" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Sync Kontact -->
                    <Button
                        android:id="@+id/syncKontactButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="16dp"
                        android:text="@string/btn_sync_kontact"
                        android:textAllCaps="true"
                        android:letterSpacing="0.02"
                        android:backgroundTint="@color/vg_green"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        app:icon="@drawable/ic_sync"
                        app:iconTint="@color/white"
                        app:iconGravity="textStart"
                        app:cornerRadius="16dp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- ================= ACTIONS ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="26dp">

            <!-- Primary upsell action - opens IncreaseLimitActivity, the
                 merged referral rewards / key redemption screen. -->
            <Button
                android:id="@+id/kontactGroupsButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/menu_increase_contact_limit"
                android:letterSpacing="0.02"
                android:backgroundTint="@color/vg_green"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:icon="@drawable/ic_contacts"
                app:iconTint="@color/white"
                app:iconGravity="textStart"
                app:cornerRadius="16dp" />

            <Button
                android:id="@+id/shareAppButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="@string/menu_share_app"
                android:textAllCaps="true"
                android:letterSpacing="0.02"
                android:textStyle="bold"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/primary_light"
                android:textColor="@color/primary_light"
                app:icon="@drawable/ic_share"
                app:iconTint="@color/primary_light"
                app:iconGravity="textStart"
                app:cornerRadius="16dp" />

        </LinearLayout>

    </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <include layout="@layout/bottom_nav_bar" />

    <!-- ================= HARD UPDATE BLOCK ================= -->
    <!-- Full-screen, non-dismissible overlay shown when the running app
         version is below the backend's min_supported_version_code (see
         SheetSync.AppUpdateInfo / MainMenuActivity.checkForAppUpdate).
         Unchanged. -->
    <LinearLayout
        android:id="@+id/hardUpdateBlockOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/primary_dark"
        android:padding="32dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_notification_bell"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/hardUpdateBlockTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:text="Update Required" />

        <TextView
            android:id="@+id/hardUpdateBlockMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="13sp"
            android:textColor="@color/white"
            android:gravity="center"
            tools:text="This version of VGKontact is no longer supported. Please update to continue." />

        <TextView
            android:id="@+id/hardUpdateBlockAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/permission_banner_background"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="UPDATE NOW"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/white" />

    </LinearLayout>

    <!-- Ban-check cover: sits on top of the dashboard until the server
         confirms the account is not banned. Unchanged. -->
    <FrameLayout
        android:id="@+id/banCheckCover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/stats_card_fill"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/vg_green" />

    </FrameLayout>

</FrameLayout>
