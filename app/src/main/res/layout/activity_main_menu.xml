<?xml version="1.0" encoding="utf-8"?>
<!--
    Cleaned-up pass: fewer competing visual weights than the previous
    revision (one filled primary button instead of three, no duplicate
    "Join More Groups" entry point, no separate helper-banner text block).

    Kontact Groups (joined-groups summary + join-more-groups action) has
    been moved off this dashboard entirely into its own screen,
    GroupsActivity/activity_groups.xml. This screen now only needs a
    single "Kontact Groups" button as the entry point to that screen -
    see kontactGroupsButton below.
-->
<!--
    Root is a FrameLayout, not a LinearLayout, so the bottom nav bar
    (see bottom_nav_bar.xml) can float over the scrollable content as
    a rounded pill instead of sitting in-flow as a full-width bar.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/apk/res-android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/stats_card_fill">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="88dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ================= HEADER (reference: .header) ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/header_gradient"
            android:gravity="center_vertical"
            android:paddingTop="48dp"
            android:paddingBottom="24dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/profileIcon"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@drawable/ic_launcher"
                android:background="@color/white"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/CircleImageShape" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/phoneNumberText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.01"
                    android:textColor="@color/white"
                    android:fontFamily="@font/baloo2"
                    tools:text="08108709625" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="5dp">

                    <!-- Group badge (reference: .group-badge). Shows the user's
                         plan tier today (planPreviewText, existing id/logic
                         preserved) inside the same pill styling the reference
                         uses for its "GROUP 1 - 5 MEMBERS" badge. -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/group_badge_background"
                        android:paddingStart="8dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/badge_dot" />

                        <TextView
                            android:id="@+id/planPreviewText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textAllCaps="true"
                            android:letterSpacing="0.04"
                            android:textColor="@color/white"
                            android:fontFamily="@font/baloo2"
                            tools:text="FREE PLAN" />

                    </LinearLayout>

                    <!-- Sync-frequency pill - same visual language as the
                         plan badge pill right next to it. Tapping it opens a
                         dropdown of frequency options right here on the
                         dashboard, so changing sync frequency no longer
                         requires going into NotificationSettingsActivity.
                         Text is set at runtime from
                         UserPrefs.getNotificationFrequencyHours() (see
                         MainMenuActivity). -->
                    <LinearLayout
                        android:id="@+id/syncFrequencyPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/group_badge_background"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_marginEnd="4dp"
                            android:src="@drawable/ic_sync"
                            app:tint="@color/white" />

                        <TextView
                            android:id="@+id/syncFrequencyText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:fontFamily="@font/baloo2"
                            tools:text="Syncs every 24h" />

                        <ImageView
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginStart="3dp"
                            android:src="@drawable/ic_arrow_forward"
                            android:rotation="90"
                            app:tint="@color/white" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <FrameLayout
< truncated lines 172-387 >

                        <TextView
                            android:id="@+id/limitWarningText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:visibility="gone"
                            tools:text="Only 1 spot left - unlock more before you run out"
                            tools:visibility="visible" />

                        <!-- Contact limit breakdown - shows where the total
                             comes from (base plan vs referral/redeemed
                             bonus), using ImportStats.baseLimit/bonusLimit.
                             Hidden entirely when either is unknown (-1) or
                             bonusLimit is 0, so a brand-new free user with
                             no bonus yet doesn't see a confusing "+0" row. -->
                        <LinearLayout
                            android:id="@+id/limitBreakdownBlock"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="14dp"
                            android:paddingTop="12dp"
                            android:background="@drawable/limit_breakdown_divider"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingTop="3dp"
                                android:paddingBottom="3dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/label_free_plan"
                                    android:textSize="13sp"
                                    android:textColor="@color/text_secondary" />

                                <TextView
                                    android:id="@+id/limitBaseText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="13sp"
                                    android:textColor="@color/vg_dark"
                                    tools:text="250" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingTop="3dp"
                                android:paddingBottom="3dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/label_referral_bonus"
                                    android:textSize="13sp"
                                    android:textColor="@color/text_secondary" />

                                <TextView
                                    android:id="@+id/limitBonusText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="13sp"
                                    android:textColor="@color/vg_green_dark"
                                    tools:text="+20" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Sync Kontact -->
                    <Button
                        android:id="@+id/syncKontactButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="18dp"
                        android:text="@string/btn_sync_kontact"
                        android:textAllCaps="true"
                        android:letterSpacing="0.02"
                        android:backgroundTint="@color/vg_green"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        app:icon="@drawable/ic_sync"
                        app:iconTint="@color/white"
                        app:iconGravity="textStart"
                        app:cornerRadius="16dp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- ================= ACTIONS (reference: .actions) ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="26dp">

            <!-- Primary upsell action, replacing the old "Kontact Groups"
                 label/entry point. Same button/id (kontactGroupsButton),
                 now opens IncreaseLimitActivity - the merged referral
                 rewards / key redemption screen. -->
            <Button
                android:id="@+id/kontactGroupsButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/menu_increase_contact_limit"
                android:letterSpacing="0.02"
                android:backgroundTint="@color/vg_green"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:icon="@drawable/ic_contacts"
                app:iconTint="@color/white"
                app:iconGravity="textStart"
                app:cornerRadius="16dp" />

            <!-- growYourViewsButton removed - its content (referral
                 campaigns + share invite) is now the "Referral rewards"
                 tab inside IncreaseLimitActivity, opened via
                 kontactGroupsButton above, so this no longer needs its
                 own separate dashboard entry point. -->

            <!-- referralHistoryButton removed - History is now reachable
                 from the bottom nav bar on every screen, so a duplicate
                 dashboard entry point is redundant. -->

            <Button
                android:id="@+id/shareAppButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="@string/menu_share_app"
                android:textAllCaps="true"
                android:letterSpacing="0.02"
                android:textStyle="bold"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/primary_light"
                android:textColor="@color/primary_light"
                app:icon="@drawable/ic_share"
                app:iconTint="@color/primary_light"
                app:iconGravity="textStart"
                app:cornerRadius="16dp" />

        </LinearLayout>

    </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <include layout="@layout/bottom_nav_bar" />

</FrameLayout>
