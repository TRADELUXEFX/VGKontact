<?xml version="1.0" encoding="utf-8"?>
<!--
    Restyled to match vgkontact_groups_ui_preview.html (the "Groups UI"
    reference mockup). Structure/section order/spacing/radii follow the
    reference as closely as native Android views allow.

    IMPORTANT - what this file does and does NOT do:
    The reference mockup shows a horizontal row of individually-named,
    individually-countable group chips ("Group 1 - 5 members", "Group 2 -
    Locked", "Group 3 - Locked", "Join More"). That level of detail needs
    a backend endpoint that lists each group's id, name, member count, and
    lock status for the current user - SheetSync.kt currently only exposes
    fetchMyGroups() (a list of group IDs the user already belongs to, no
    names/counts/lock-state for OTHER groups). Rather than fabricate that
    data client-side, the "Your Groups" section below shows an honest
    summary card (how many groups you've joined) sourced from real data,
    plus a "Join More Groups" chip wired to the existing key-redeem flow
    (UpgradePlanActivity). Swap in a real per-group chip loop the moment a
    "list groups with member counts" endpoint exists - see the comment
    above the groupsScrollContainer below for exactly where.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/apk/res-android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/stats_card_fill"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ================= HEADER (reference: .header) ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/header_gradient"
            android:gravity="center_vertical"
            android:paddingTop="48dp"
            android:paddingBottom="24dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageView
                android:id="@+id/profileIcon"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:padding="13dp"
                android:src="@drawable/ic_profile"
                android:background="@drawable/avatar_circle_background"
                android:clickable="true"
                android:focusable="true"
                app:tint="@color/vg_green" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/phoneNumberText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.01"
                    android:textColor="@color/white"
                    android:fontFamily="sans-serif-medium"
                    tools:text="08108709625" />

                <!-- Group badge (reference: .group-badge). Shows the user's
                     plan tier today (planPreviewText, existing id/logic
                     preserved) inside the same pill styling the reference
                     uses for its "GROUP 1 - 5 MEMBERS" badge. -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/group_badge_background"
                    android:paddingStart="8dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/badge_dot" />

                    <TextView
                        android:id="@+id/planPreviewText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textAllCaps="true"
                        android:letterSpacing="0.04"
                        android:textColor="@color/white"
                        android:fontFamily="sans-serif-medium"
                        tools:text="FREE PLAN" />

                </LinearLayout>

            </LinearLayout>

            <ImageView
                android:id="@+id/notificationIcon"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:padding="11dp"
                android:src="@drawable/ic_notification_bell"
                android:background="@drawable/notification_circle_background"
                android:clickable="true"
                android:focusable="true"
                app:tint="@color/white" />

        </LinearLayout>

        <!-- Permission health banner - app-specific safety feature with no
             reference equivalent, kept as-is (unchanged id/logic) since it's
             functionally important; it simply sits below the header instead
             of overlapping it. -->
        <LinearLayout
            android:id="@+id/permissionWarningBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/permission_banner_background"
            android:padding="14dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/permissionWarningIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_battery"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/permissionWarningText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                tools:text="Contacts permission is off - Sync is disabled" />

            <TextView
                android:id="@+id/permissionWarningAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FIX"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:paddingStart="10dp"
                android:paddingEnd="4dp" />

        </LinearLayout>

        <!-- ================= BODY (reference: .body) ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/statsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/statsProgressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:id="@+id/statsContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:visibility="gone">

                    <!-- Optional grand-total headline (hidden by default) -->
                    <TextView
                        android:id="@+id/statsTotalText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="36sp"
                        android:textStyle="bold"
                        android:textColor="@color/vg_green"
                        android:visibility="gone"
                        tools:text="41" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/stats_total_label"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textAllCaps="true"
                        android:letterSpacing="0.05"
                        android:textColor="@color/text_muted"
                        android:visibility="gone" />

                    <!-- Sync status line (reference: .sync-status) - icon +
                         centered text, no card, sits above the stat tiles. -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingBottom="18dp">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_sync"
                            app:tint="@color/vg_green" />

                        <TextView
                            android:id="@+id/statsTodayText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="13.5sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_muted"
                            tools:text="No kontacts synced today" />

                    </LinearLayout>

                    <!-- Stat tiles row (reference: .stats-row / .stat-card).
                         Left = "In Your Group" (was "Total in database"),
                         right = "New To Import" (was "Available to import") -
                         same underlying stats.totalInDatabase /
                         stats.availableToImport values, relabeled to match
                         the reference's group-scoped framing, which is
                         already accurate: fetchImportStats() only counts
                         contacts within the groups this user has joined. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/stats_tile_neutral_background"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp">

                            <TextView
                                android:id="@+id/statsDatabaseTotalText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="26sp"
                                android:textStyle="bold"
                                android:textColor="@color/vg_dark"
                                android:fontFamily="sans-serif-medium"
                                tools:text="6" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/stats_database_total_label"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:textAllCaps="true"
                                android:letterSpacing="0.04"
                                android:textColor="@color/text_muted"
                                android:gravity="center" />

                        </LinearLayout>

                        <!-- id added so Kotlin can swap this tile's
                             background to the dashed "zero" style when
                             availableToImport == 0, matching reference's
                             .stat-card.zero state. See MainMenuActivity. -->
                        <LinearLayout
                            android:id="@+id/statsAvailableTile"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/stats_tile_accent_background"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp">

                            <TextView
                                android:id="@+id/statsAvailableText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="26sp"
                                android:textStyle="bold"
                                android:textColor="@color/vg_green"
                                android:fontFamily="sans-serif-medium"
                                tools:text="0" />

                            <TextView
                                android:id="@+id/statsAvailableLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/stats_available_label"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:textAllCaps="true"
                                android:letterSpacing="0.04"
                                android:textColor="@color/vg_green"
                                android:gravity="center" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Helper banner (reference: .helper-banner). Text is
                         built dynamically in MainMenuActivity from the same
                         numbers already on screen, so it never contradicts
                         the stat tiles above it. -->
                    <LinearLayout
                        android:id="@+id/helperBanner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:background="@drawable/helper_banner_background"
                        android:paddingStart="13dp"
                        android:paddingEnd="13dp"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginTop="1dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_info"
                            app:tint="@color/vg_green_dark" />

                        <TextView
                            android:id="@+id/helperBannerText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="12.5sp"
                            android:lineSpacingMultiplier="1.15"
                            android:textColor="@color/helper_banner_text"
                            tools:text="You're fully synced with Group 1 - all 6 members are already saved to your phone. Join another group to unlock more people to sync." />

                    </LinearLayout>

                    <!-- ============ YOUR GROUPS (reference: .section-label
                         + .groups-scroll) ============
                         See the file-level comment at the top for why this
                         is a summary card rather than per-group chips. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Your Groups"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/vg_dark"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/groupsCountText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="11.5sp"
                            android:textColor="@color/text_muted"
                            tools:text="1 joined" />

                    </LinearLayout>

                    <!-- Horizontally-scrolling chip row, same shape as the
                         reference's .groups-scroll. Currently holds exactly
                         two chips: a joined-groups summary (real data) and
                         a "Join More Groups" action chip (wired to the
                         existing key-redeem screen). To add real per-group
                         chips once a backend list-groups endpoint exists:
                         inflate one group_chip_active/locked view per group
                         inside groupsScrollContainer, before joinMoreChip. -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:scrollbars="none"
                        android:clipToPadding="false"
                        android:paddingStart="0dp"
                        android:paddingEnd="4dp">

                        <LinearLayout
                            android:id="@+id/groupsScrollContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- Joined-groups summary chip (reference:
                                 .group-chip.active) -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="10dp"
                                android:orientation="vertical"
                                android:background="@drawable/group_chip_active_background"
                                android:minWidth="130dp"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp"
                                android:paddingTop="13dp"
                                android:paddingBottom="13dp">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:background="@drawable/check_circle_background"
                                    android:padding="3.5dp"
                                    android:src="@drawable/ic_check"
                                    app:tint="@color/vg_green_dark" />

                                <TextView
                                    android:id="@+id/joinedGroupsTitleText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/white"
                                    android:fontFamily="sans-serif-medium"
                                    tools:text="Your Groups" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical">

                                    <ImageView
                                        android:layout_width="11dp"
                                        android:layout_height="11dp"
                                        android:layout_marginEnd="4dp"
                                        android:src="@drawable/ic_contacts"
                                        app:tint="@color/white" />

                                    <TextView
                                        android:id="@+id/joinedGroupsMetaText"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="11sp"
                                        android:alpha="0.9"
                                        android:textColor="@color/white"
                                        tools:text="6 members" />

                                </LinearLayout>

                            </LinearLayout>

                            <!-- "Join More Groups" chip (reference:
                                 .group-chip.add). Tapping it does exactly
                                 what the reference's button does: opens the
                                 key-redeem screen (existing
                                 upgradePlanButton target, UpgradePlanActivity),
                                 just presented as a chip here too so both the
                                 chip and the bottom button work. -->
                            <LinearLayout
                                android:id="@+id/joinMoreChip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:background="@drawable/group_chip_add_background"
                                android:minWidth="110dp"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp"
                                android:paddingTop="13dp"
                                android:paddingBottom="13dp"
                                android:clickable="true"
                                android:focusable="true">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_marginBottom="3dp"
                                    android:src="@drawable/ic_add"
                                    app:tint="@color/vg_green" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Join More"
                                    android:textSize="12.5sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/vg_green_dark"
                                    android:fontFamily="sans-serif-medium" />

                            </LinearLayout>

                        </LinearLayout>

                    </HorizontalScrollView>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- ================= ACTIONS (reference: .actions) ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="26dp">

            <Button
                android:id="@+id/syncKontactButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/btn_sync_kontact"
                android:textAllCaps="true"
                android:letterSpacing="0.02"
                android:backgroundTint="@color/vg_green"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:icon="@drawable/ic_sync"
                app:iconTint="@color/white"
                app:iconGravity="textStart"
                app:cornerRadius="16dp" />

            <!-- Caption under the primary button (reference: .btn-caption) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Pulls new numbers from your joined groups into your phone contacts."
                android:textSize="11sp"
                android:textColor="@color/text_muted"
                android:gravity="center"
                android:lineSpacingMultiplier="1.2"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />

            <Button
                android:id="@+id/upgradePlanButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:text="JOIN MORE GROUPS"
                android:letterSpacing="0.02"
                android:backgroundTint="@color/vg_green"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:icon="@drawable/ic_add"
                app:iconTint="@color/white"
                app:iconGravity="textStart"
                app:cornerRadius="16dp" />

            <Button
                android:id="@+id/kontactHistoryButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="@string/menu_history"
                android:textAllCaps="true"
                android:letterSpacing="0.02"
                android:textStyle="bold"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/primary_light"
                android:textColor="@color/primary_light"
                app:icon="@drawable/ic_contacts"
                app:iconTint="@color/primary_light"
                app:iconGravity="textStart"
                app:cornerRadius="16dp" />

            <Button
                android:id="@+id/contactUsButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="@string/menu_contact_us"
                android:textAllCaps="true"
                android:letterSpacing="0.02"
                android:textStyle="bold"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:icon="@drawable/ic_chat"
                app:iconTint="@color/primary_light"
                app:iconGravity="textStart"
                app:strokeColor="@color/primary_light"
                android:textColor="@color/primary_light"
                app:cornerRadius="16dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
