<?xml version="1.0" encoding="utf-8"?>
<!--
    Cleaned-up pass: fewer competing visual weights than the previous
    revision (one filled primary button instead of three, no duplicate
    "Join More Groups" entry point, no separate helper-banner text block).

    Kontact Groups (joined-groups summary + join-more-groups action) has
    been moved off this dashboard entirely into its own screen,
    GroupsActivity/activity_groups.xml. This screen now only needs a
    single "Kontact Groups" button as the entry point to that screen -
    see kontactGroupsButton below.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/apk/res-android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<androidx.core.widget.NestedScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/stats_card_fill"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="72dp">

        <!-- ================= HEADER (reference: .header) ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/header_gradient"
            android:gravity="center_vertical"
            android:paddingTop="48dp"
            android:paddingBottom="24dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageView
                android:id="@+id/appLogoIcon"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:padding="6dp"
                android:src="@drawable/ic_launcher"
                android:background="@drawable/avatar_circle_background"
                android:scaleType="centerCrop"
                android:clipToOutline="true" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/phoneNumberText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.01"
                    android:textColor="@color/white"
                    android:fontFamily="@font/baloo2"
                    tools:text="08108709625" />

                <!-- Group badge (reference: .group-badge). Shows the user's
                     plan tier today (planPreviewText, existing id/logic
                     preserved) inside the same pill styling the reference
                     uses for its "GROUP 1 - 5 MEMBERS" badge. -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/group_badge_background"
                    android:paddingStart="8dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/badge_dot" />

                    <TextView
                        android:id="@+id/planPreviewText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textAllCaps="true"
                        android:letterSpacing="0.04"
                        android:textColor="@color/white"
                        android:fontFamily="@font/baloo2"
                        tools:text="FREE PLAN" />

                </LinearLayout>

            </LinearLayout>

            <ImageView
                android:id="@+id/notificationIcon"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:padding="11dp"
                android:src="@drawable/ic_notification_bell"
                android:background="@drawable/notification_circle_background"
                android:clickable="true"
                android:focusable="true"
                app:tint="@color/white" />

        </LinearLayout>

        <!-- Permission health banner - app-specific safety feature with no
             reference equivalent, kept as-is (unchanged id/logic) since it's
             functionally important; it simply sits below the header instead
             of overlapping it. -->
        <LinearLayout
            android:id="@+id/permissionWarningBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/permission_banner_background"
            android:padding="14dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/permissionWarningIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_battery"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/permissionWarningText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                tools:text="Contacts permission is off - Sync is disabled" />

            <TextView
                android:id="@+id/permissionWarningAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FIX"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:paddingStart="10dp"
                android:paddingEnd="4dp" />

        </LinearLayout>

        <!-- ================= BODY (reference: .body) ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp">

            <!-- Sync stats card -->
            <LinearLayout
                android:id="@+id/statsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="20dp">

                <ProgressBar
                    android:id="@+id/statsProgressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/statsContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginBottom="18dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_sync"
                            app:tint="@color/vg_green" />

                        <TextView
                            android:id="@+id/statsTodayText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/vg_dark"
                            tools:text="3 kontacts synced today" />

                    </LinearLayout>

                    <!-- ===== Contact Limit meter =====
                         Replaces the old "total in database / available to
                         import" two-tile row. current = syncedToPhone,
                         limit = contactLimit (sum of joined groups' real
                         caps on Supabase - see ImportStats.contactLimit).
                         Bar color + width are set entirely in Kotlin
                         (updateLimitMeter in MainMenuActivity), same
                         green -> amber -> red threshold behavior as the
                         approved HTML preview. -->
                    <LinearLayout
                        android:id="@+id/limitBlock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/limit_block_background"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/contact_limit_label"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textAllCaps="true"
                            android:letterSpacing="0.05"
                            android:textColor="@color/text_muted"
                            android:gravity="center" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="14dp"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:baselineAligned="true">

                            <TextView
                                android:id="@+id/limitCurrentText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="34sp"
                                android:textStyle="bold"
                                android:textColor="@color/vg_dark"
                                android:fontFamily="@font/baloo2"
                                tools:text="15" />

                            <TextView
                                android:id="@+id/limitOfText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_muted"
                                tools:text="/ 250" />

                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/limitMeterBar"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="14dp"
                            android:max="100"
                            android:progress="2"
                            android:progressDrawable="@drawable/limit_meter_progress" />

                        <TextView
                            android:id="@+id/limitPctText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_muted"
                            android:gravity="center"
                            tools:text="2% used" />

                        <TextView
                            android:id="@+id/limitWarningText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:visibility="gone"
                            tools:text="Only 1 spot left - unlock more before you run out"
                            tools:visibility="visible" />

                        <!-- Contact limit breakdown - shows where the total
                             comes from (base plan vs referral/redeemed
                             bonus), using ImportStats.baseLimit/bonusLimit.
                             Hidden entirely when either is unknown (-1) or
                             bonusLimit is 0, so a brand-new free user with
                             no bonus yet doesn't see a confusing "+0" row. -->
                        <LinearLayout
                            android:id="@+id/limitBreakdownBlock"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="14dp"
                            android:paddingTop="12dp"
                            android:background="@drawable/limit_breakdown_divider"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingTop="3dp"
                                android:paddingBottom="3dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/label_free_plan"
                                    android:textSize="13sp"
                                    android:textColor="@color/text_secondary" />

                                <TextView
                                    android:id="@+id/limitBaseText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="13sp"
                                    android:textColor="@color/vg_dark"
                                    tools:text="250" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingTop="3dp"
                                android:paddingBottom="3dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/label_referral_bonus"
                                    android:textSize="13sp"
                                    android:textColor="@color/text_secondary" />

                                <TextView
                                    android:id="@+id/limitBonusText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="13sp"
                                    android:textColor="@color/vg_green_dark"
                                    tools:text="+20" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Sync Kontact -->
                    <Button
                        android:id="@+id/syncKontactButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="18dp"
                        android:text="@string/btn_sync_kontact"
                        android:textAllCaps="true"
                        android:letterSpacing="0.02"
                        android:backgroundTint="@color/vg_green"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        app:icon="@drawable/ic_sync"
                        app:iconTint="@color/white"
                        app:iconGravity="textStart"
                        app:cornerRadius="16dp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- ================= ACTIONS (reference: .actions) ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="26dp">

            <!-- kontactGroupsButton (Increase Contact Limit) and
                 referralHistoryButton removed from the dashboard body -
                 both destinations are now reachable directly via the
                 bottom navigation bar (bottomNavView, Upgrade / History
                 tabs) added below, per Jacob's Law: don't duplicate a
                 tab's destination with an inline button on another
                 screen. -->

            <!-- Invite/share entry point - kept as an inline button since
                 no bottom nav tab covers it. -->
            <Button
                android:id="@+id/shareAppButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/menu_share_app"
                android:textAllCaps="true"
                android:letterSpacing="0.02"
                android:textStyle="bold"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/primary_light"
                android:textColor="@color/primary_light"
                app:icon="@drawable/ic_share"
                app:iconTint="@color/primary_light"
                app:iconGravity="textStart"
                app:cornerRadius="16dp" />

            <Button
                android:id="@+id/contactUsButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="@string/menu_contact_us"
                android:textAllCaps="true"
                android:letterSpacing="0.02"
                android:textStyle="bold"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:icon="@drawable/ic_chat"
                app:iconTint="@color/primary_light"
                app:iconGravity="textStart"
                app:strokeColor="@color/primary_light"
                android:textColor="@color/primary_light"
                app:cornerRadius="16dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>

    <!-- Bottom navigation - Jacob's Law layout: home far left, profile far
         right, core destinations in between. Settings does not get its own
         tab (see main_menu_title/"Settings" - that concept is now folded
         into Profile instead). Menu defined in res/menu/bottom_nav_menu.xml. -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/white"
        app:itemIconTint="@color/bottom_nav_item_color"
        app:itemTextColor="@color/bottom_nav_item_color"
        app:menu="@menu/bottom_nav_menu"
        app:elevation="8dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
