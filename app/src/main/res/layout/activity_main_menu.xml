<?xml version="1.0" encoding="utf-8"?>
<!--
    Cleaned-up pass: fewer competing visual weights than the previous
    revision (one filled primary button instead of three, no duplicate
    "Join More Groups" entry point, no separate helper-banner text block).

    Kontact Groups (joined-groups summary + join-more-groups action) has
    been moved off this dashboard entirely into its own screen,
    GroupsActivity/activity_groups.xml. This screen now only needs a
    single "Kontact Groups" button as the entry point to that screen -
    see kontactGroupsButton below.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/apk/res-android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/stats_card_fill"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ================= HEADER (reference: .header) ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/header_gradient"
            android:gravity="center_vertical"
            android:paddingTop="48dp"
            android:paddingBottom="24dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageView
                android:id="@+id/profileIcon"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:padding="13dp"
                android:src="@drawable/ic_profile"
                android:background="@drawable/avatar_circle_background"
                android:clickable="true"
                android:focusable="true"
                app:tint="@color/vg_green" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/phoneNumberText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.01"
                    android:textColor="@color/white"
                    android:fontFamily="@font/baloo2"
                    tools:text="08108709625" />

                <!-- Group badge (reference: .group-badge). Shows the user's
                     plan tier today (planPreviewText, existing id/logic
                     preserved) inside the same pill styling the reference
                     uses for its "GROUP 1 - 5 MEMBERS" badge. -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/group_badge_background"
                    android:paddingStart="8dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/badge_dot" />

                    <TextView
                        android:id="@+id/planPreviewText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textAllCaps="true"
                        android:letterSpacing="0.04"
                        android:textColor="@color/white"
                        android:fontFamily="@font/baloo2"
                        tools:text="FREE PLAN" />

                </LinearLayout>

            </LinearLayout>

            <ImageView
                android:id="@+id/notificationIcon"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:padding="11dp"
                android:src="@drawable/ic_notification_bell"
                android:background="@drawable/notification_circle_background"
                android:clickable="true"
                android:focusable="true"
                app:tint="@color/white" />

        </LinearLayout>

        <!-- Permission health banner - app-specific safety feature with no
             reference equivalent, kept as-is (unchanged id/logic) since it's
             functionally important; it simply sits below the header instead
             of overlapping it. -->
        <LinearLayout
            android:id="@+id/permissionWarningBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/permission_banner_background"
            android:padding="14dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/permissionWarningIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_battery"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/permissionWarningText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                tools:text="Contacts permission is off - Sync is disabled" />

            <TextView
                android:id="@+id/permissionWarningAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FIX"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:paddingStart="10dp"
                android:paddingEnd="4dp" />

        </LinearLayout>

        <!-- ================= BODY (reference: .body) ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp">

            <!-- Sync stats card -->
            <LinearLayout
                android:id="@+id/statsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="20dp">

                <ProgressBar
                    android:id="@+id/statsProgressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/statsContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_synced_today"
                            android:textSize="13sp"
                            android:textColor="@color/text_muted" />

                        <TextView
                            android:id="@+id/statsTodayText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/vg_dark"
                            tools:text="0" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="18dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_synced_total"
                            android:textSize="13sp"
                            android:textColor="@color/text_muted" />

                        <TextView
                            android:id="@+id/statsTotalText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/vg_dark"
                            tools:text="0" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/stats_tile_neutral_background"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp">

                            <TextView
                                android:id="@+id/statsDatabaseTotalText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="26sp"
                                android:textStyle="bold"
                                android:textColor="@color/vg_dark"
                                android:fontFamily="@font/baloo2"
                                tools:text="6" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/stats_database_total_label"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:textAllCaps="true"
                                android:letterSpacing="0.04"
                                android:textColor="@color/text_muted"
                                android:gravity="center" />

                        </LinearLayout>

                        <!-- id added so Kotlin can swap this tile's
                             background to the dashed "zero" style when
                             availableToImport == 0, matching reference's
                             .stat-card.zero state. See MainMenuActivity. -->
                        <LinearLayout
                            android:id="@+id/statsAvailableTile"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/stats_tile_accent_background"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp">

                            <TextView
                                android:id="@+id/statsAvailableText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="26sp"
                                android:textStyle="bold"
                                android:textColor="@color/vg_green"
                                android:fontFamily="@font/baloo2"
                                tools:text="0" />

                            <TextView
                                android:id="@+id/statsAvailableLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/stats_available_label"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:textAllCaps="true"
                                android:letterSpacing="0.04"
                                android:textColor="@color/vg_green"
                                android:gravity="center" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Sync Kontact -->
                    <Button
                        android:id="@+id/syncKontactButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="18dp"
                        android:text="@string/btn_sync_kontact"
                        android:textAllCaps="true"
                        android:letterSpacing="0.02"
                        android:backgroundTint="@color/vg_green"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        app:icon="@drawable/ic_sync"
                        app:iconTint="@color/white"
                        app:iconGravity="textStart"
                        app:cornerRadius="16dp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- ================= ACTIONS (reference: .actions) ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="26dp">

            <!-- Single entry point for everything groups-related (list of
                 joined groups + join-more action) - opens GroupsActivity.
                 Replaces the former summary card + eye icon + separate
                 "Join More Groups" button that used to live on this
                 dashboard. -->
            <Button
                android:id="@+id/kontactGroupsButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/menu_kontact_groups"
                android:letterSpacing="0.02"
                android:backgroundTint="@color/vg_green"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:icon="@drawable/ic_contacts"
                app:iconTint="@color/white"
                app:iconGravity="textStart"
                app:cornerRadius="16dp" />

            <Button
                android:id="@+id/referralHistoryButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="@string/menu_referral_history"
                android:textAllCaps="true"
                android:letterSpacing="0.02"
                android:textStyle="bold"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/primary_light"
                android:textColor="@color/primary_light"
                app:icon="@drawable/ic_history"
                app:iconTint="@color/primary_light"
                app:iconGravity="textStart"
                app:cornerRadius="16dp" />

            <Button
                android:id="@+id/contactUsButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="@string/menu_contact_us"
                android:textAllCaps="true"
                android:letterSpacing="0.02"
                android:textStyle="bold"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:icon="@drawable/ic_chat"
                app:iconTint="@color/primary_light"
                app:iconGravity="textStart"
                app:strokeColor="@color/primary_light"
                android:textColor="@color/primary_light"
                app:cornerRadius="16dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
