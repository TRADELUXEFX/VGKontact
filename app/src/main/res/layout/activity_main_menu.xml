<?xml version="1.0" encoding="utf-8"?>
<!--
    This screen has no direct equivalent in vgkontact_groups_ui_preview.html
    (the reference only covers the main dashboard). It's restyled here using
    the same tokens the dashboard now uses - green gradient header, 16dp
    corner radii, card-style input - purely so it doesn't feel like a
    different, older app the moment a user taps "Join More Groups" from the
    dashboard.

    Title/subtitle carry IDs (upgradeTitleText / upgradeSubtitleText) so
    UpgradePlanActivity can swap in group-specific copy when opened from a
    tap on a specific group row (see GroupsActivity / EXTRA_TARGET_GROUP_ID).
    A "Don't have a code? Contact Us" button is included here too, matching
    the one on the Groups screen, so a user who lands here without a code
    still has a way out.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/stats_card_fill"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/header_gradient"
            android:paddingTop="48dp"
            android:paddingBottom="32dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:gravity="center">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@drawable/ic_add"
                android:background="@drawable/avatar_circle_background"
                app:tint="@color/vg_green" />

            <TextView
                android:id="@+id/upgradeTitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/title_upgrade_plan"
                android:textSize="21sp"
                android:textStyle="bold"
                android:fontFamily="@font/baloo2"
                android:textColor="@color/white" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="top"
            android:padding="24dp">

            <TextView
                android:id="@+id/upgradeSubtitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/upgrade_plan_coming_soon"
                android:textSize="14.5sp"
                android:lineSpacingMultiplier="1.3"
                android:textColor="@color/text_muted"
                android:gravity="center"
                android:layout_marginBottom="22dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="4dp"
                android:layout_marginBottom="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxBackgroundMode="none"
                    app:hintTextColor="@color/vg_green"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/keyCodeInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_key_code"
                        android:inputType="textCapCharacters"
                        android:textSize="15sp"
                        android:letterSpacing="0.05"
                        android:maxLines="1" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <Button
                android:id="@+id/redeemKeyButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/btn_redeem_key"
                android:textAllCaps="true"
                android:letterSpacing="0.02"
                android:backgroundTint="@color/vg_green"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:cornerRadius="16dp" />

            <Button
                android:id="@+id/noCodeContactUsButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="@string/btn_no_code_contact_us"
                android:textAllCaps="true"
                android:letterSpacing="0.02"
                android:textStyle="bold"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/primary_light"
                android:textColor="@color/primary_light"
                app:icon="@drawable/ic_chat"
                app:iconTint="@color/primary_light"
                app:iconGravity="textStart"
                app:cornerRadius="16dp" />

            <ProgressBar
                android:id="@+id/redeemProgressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_gravity="center_horizontal"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
