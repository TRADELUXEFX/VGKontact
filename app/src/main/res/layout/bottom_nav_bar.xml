<?xml version="1.0" encoding="utf-8"?>
<!--
    Floating pill nav bar. Meant to be the last child of a FrameLayout
    (see nav_screen_wrapper.xml), positioned bottom|center with side/
    bottom margins so it floats above the content edge-to-edge with a
    gap, instead of the old flat full-width in-flow bar.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomNavBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:layout_marginStart="14dp"
    android:layout_marginEnd="14dp"
    android:layout_marginBottom="14dp"
    android:orientation="horizontal"
    android:background="@drawable/floating_nav_background"
    android:elevation="10dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:paddingStart="6dp"
    android:paddingEnd="6dp">

    <LinearLayout
        android:id="@+id/navHomeTab"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/navHomeIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_home"
            app:tint="@color/text_muted" />

        <TextView
            android:id="@+id/navHomeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/nav_home"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/text_muted" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/navUpgradeTab"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/navUpgradeIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_crown"
            app:tint="@color/text_muted" />

        <TextView
            android:id="@+id/navUpgradeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/nav_upgrade"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/text_muted" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/navHistoryTab"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/navHistoryIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_history"
            app:tint="@color/text_muted" />

        <TextView
            android:id="@+id/navHistoryLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/nav_history"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/text_muted" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/navProfileTab"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/navProfileIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_profile"
            app:tint="@color/text_muted" />

        <TextView
            android:id="@+id/navProfileLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/nav_profile"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/text_muted" />

    </LinearLayout>

</LinearLayout>
