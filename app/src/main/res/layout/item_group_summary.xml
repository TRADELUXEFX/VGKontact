<?xml version="1.0" encoding="utf-8"?>
<!--
    One row in the "all groups" list on the Groups screen. Shows the
    group number plus the kontact count for that group (extra-key counts
    are an internal concept and intentionally not shown to the user).
    Inflated once per group returned by SheetSync.fetchAllGroupsSummary().
    Tapping a row jumps to the unlock screen pre-targeted at this group
    (see GroupsActivity.openUnlockScreenFor()).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/card_background"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_marginBottom="8dp">

    <TextView
        android:id="@+id/groupRowTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/vg_dark"
        android:fontFamily="@font/manrope"
        tools:text="Group 1" />

    <TextView
        android:id="@+id/groupRowCounts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textSize="12sp"
        android:textColor="@color/text_muted"
        tools:text="5 kontacts" />

</LinearLayout>
