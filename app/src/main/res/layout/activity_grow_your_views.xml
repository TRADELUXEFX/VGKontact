<?xml version="1.0" encoding="utf-8"?>
<!--
    Grow your views - referral milestone screen.
    Structural shell copied from activity_history.xml (gradient header +
    ProgressBar + emptyText + ScrollView) for visual consistency. The
    contact-limit meter block below reuses the exact same nested-card
    pattern as activity_main_menu.xml's limitBlock (card_background outer,
    limit_block_background inner), just without the sync button, since
    this screen isn't about syncing.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/apk/res-android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/stats_card_fill">

    <!-- Green gradient header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/header_gradient"
        android:paddingTop="48dp"
        android:paddingBottom="28dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_grow_your_views"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:fontFamily="@font/baloo2" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/subtitle_grow_your_views"
            android:textSize="13sp"
            android:textColor="#DCF5E8" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="24dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/emptyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:gravity="center"
        android:textColor="@color/text_muted"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="28dp">

            <!-- Contact limit card - same nested-card pattern as the
                 dashboard's limitBlock, showing the user's real current
                 numbers so a claim's effect is visible immediately. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="20dp"
                android:layout_marginBottom="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_your_status_viewers"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.05"
                    android:textColor="@color/text_muted"
                    android:gravity="center"
                    android:layout_marginBottom="14dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/limit_block_background"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:id="@+id/limitCurrentText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="34sp"
                            android:textStyle="bold"
                            android:textColor="@color/vg_dark"
                            android:fontFamily="@font/baloo2"
                            tools:text="15" />

                        <TextView
                            android:id="@+id/limitOfText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_muted"
                            tools:text="/ 250" />

                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/limitMeterBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="14dp"
                        android:max="100"
                        android:progress="2"
                        android:progressDrawable="@drawable/limit_meter_progress" />

                    <TextView
                        android:id="@+id/limitPctText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_muted"
                        android:gravity="center"
                        tools:text="6% used" />

                </LinearLayout>

            </LinearLayout>

            <!-- Share button - opens the system share sheet with a
                 pre-written invite message (wired in the Activity). -->
            <Button
                android:id="@+id/shareInviteButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="20dp"
                android:text="@string/btn_share_invite_link"
                android:textAllCaps="true"
                android:letterSpacing="0.02"
                android:backgroundTint="@color/vg_green"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:icon="@drawable/ic_share"
                app:iconTint="@color/white"
                app:iconGravity="textStart"
                app:cornerRadius="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_earn_more_views"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/vg_dark"
                android:layout_marginBottom="10dp" />

            <!-- Campaign cards are built and inserted here at runtime -
                 one child view per active campaign, from
                 CampaignProgress list. See
                 GrowYourViewsActivity.renderCampaignCards(). -->
            <LinearLayout
                android:id="@+id/campaignCardsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Shown instead of campaignCardsContainer when there are no
                 active campaigns right now. -->
            <TextView
                android:id="@+id/noCampaignsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp"
                android:gravity="center"
                android:textSize="13sp"
                android:textColor="@color/text_muted"
                android:text="@string/empty_no_active_campaigns"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
