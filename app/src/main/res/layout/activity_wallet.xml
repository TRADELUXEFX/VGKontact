<?xml version="1.0" encoding="utf-8"?>
<!--
    Placeholder screen for the Wallet bottom-nav tab. Intentionally
    blank aside from a centered wallet icon - no wallet feature exists
    yet, this just proves the tab is real and clickable. Root is a
    FrameLayout so the bottom nav bar can float over the content as a
    rounded pill (see bottom_nav_bar.xml), matching every other screen.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/stats_card_fill">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingBottom="88dp">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_wallet"
            app:tint="@color/text_muted" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/nav_wallet"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins"
            android:textColor="@color/text_muted" />

    </LinearLayout>

    <include layout="@layout/bottom_nav_bar" />

</FrameLayout>
