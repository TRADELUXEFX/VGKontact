<?xml version="1.0" encoding="utf-8"?>
<!--
    Increase Contact Limit - merged screen. Replaces the two separate
    destinations activity_grow_your_views.xml and activity_upgrade_plan.xml,
    which both existed to do the same underlying thing (raise the user's
    contact limit) via two different mechanisms:
      - referral milestones (campaign cards + share button)
      - key code redemption

    Structure: gradient header, then one shared limit card (uses the same
    3-source breakdown - Free plan / Unlocked group / Referral bonus - as
    the dashboard's limitBreakdownBlock, per updateLimitMeter() in
    MainMenuActivity.kt) that stays fixed regardless of which tab is
    active, then a two-tab switcher below it:
      - "Referral rewards" (former activity_grow_your_views.xml content)
      - "Redeem a key" (former activity_upgrade_plan.xml content)

    Only one tab's content is visible at a time; both panels are inflated
    up front and toggled via visibility in IncreaseLimitActivity, so
    switching tabs never re-fetches data that's already loaded.
-->
<!--
    Root is a FrameLayout so the bottom nav bar can float over the
    content as a rounded pill (see bottom_nav_bar.xml) instead of
    sitting in-flow as a full-width bar.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/apk/res-android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/stats_card_fill">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Green gradient header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/header_gradient"
        android:paddingTop="48dp"
        android:paddingBottom="28dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:gravity="center">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_increase_limit"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:textAlignment="center"
            android:fontFamily="@font/poppins" />

        <!-- ============ TAB SWITCHER (segmented control) ============
             Same header_tab_track_background pattern as HistoryActivity's
             tabMyReferralsButton/tabLeaderboardButton - splits the single
             stacked keyPanel below into two separate panels (purchasePanel /
             unlockPanel) shown one at a time, per request. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/header_tab_track_background"
            android:padding="4dp"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/tabPurchaseButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/tab_purchase_code"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="@android:color/transparent"
                android:textColor="@color/white"
                app:cornerRadius="12dp"
                app:elevation="0dp"
                app:rippleColor="@color/vg_green_tint"
                android:stateListAnimator="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <Button
                android:id="@+id/tabUnlockButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="@string/tab_redeem_key"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="@android:color/transparent"
                android:textColor="@color/white"
                app:cornerRadius="12dp"
                app:elevation="0dp"
                app:rippleColor="@color/vg_green_tint"
                android:stateListAnimator="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

        </LinearLayout>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="88dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="28dp">

            <!-- ============ PURCHASE PANEL ============
                 Contact amount picker + "Purchase Code" (WhatsApp) button.
                 Content unchanged from the former single keyPanel - only
                 split out into its own toggleable panel. -->
            <LinearLayout
                android:id="@+id/purchasePanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- ============ PACKAGE PLAN CARDS ============
                     Replaces the old +/- contact-amount stepper with three
                     fixed packages (250 / 750 / 1000 status viewers), shown
                     as tappable cards - same selected/default tile pattern
                     used in NotificationSettingsActivity (freq_tile_*).
                     Tapping a card sets the selected package; the price
                     shown per card and the WhatsApp message below both
                     follow PACKAGES in IncreaseLimitActivity.kt. -->
                <LinearLayout
                    android:id="@+id/packageCard250"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/freq_tile_default_background"
                    android:padding="14dp"
                    android:layout_marginBottom="10dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="250 status viewers"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/vg_dark" />

                    <TextView
                        android:id="@+id/packagePrice250"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/vg_green_dark"
                        tools:text="₦10,000" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/packageCard500"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/freq_tile_default_background"
                    android:padding="14dp"
                    android:layout_marginBottom="10dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="500 status viewers"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/vg_dark" />

                    <TextView
                        android:id="@+id/packagePrice500"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/vg_green_dark"
                        tools:text="₦20,000" />

                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:id="@+id/packageCard1000"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/freq_tile_selected_background"
                        android:padding="14dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="1000 status viewers"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/vg_dark" />

                        <TextView
                            android:id="@+id/packagePrice1000"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/vg_green_dark"
                            tools:text="₦40,000" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="Best value"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:background="@drawable/tab_selected_background"
                        android:backgroundTint="@color/vg_green"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp" />

                </FrameLayout>

                <Button
                    android:id="@+id/noCodeContactUsButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/btn_no_code_contact_us"
                    android:textAllCaps="true"
                    android:letterSpacing="0.02"
                    android:backgroundTint="@color/vg_green"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:cornerRadius="16dp" />

            </LinearLayout>

            <!-- ============ UNLOCK PANEL ============
                 Key code input + "Unlock" button. Content unchanged from
                 the former single keyPanel - only split out into its own
                 toggleable panel. -->
            <LinearLayout
                android:id="@+id/unlockPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/upgradeSubtitleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/upgrade_plan_coming_soon"
                    android:textSize="14.5sp"
                    android:lineSpacingMultiplier="1.3"
                    android:textColor="@color/text_muted"
                    android:gravity="center"
                    android:layout_marginBottom="20dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_background"
                    android:padding="4dp"
                    android:layout_marginBottom="16dp">

                    <EditText
                        android:id="@+id/keyCodeInput"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:hint="@string/hint_key_code"
                        android:textColorHint="@color/text_muted"
                        android:gravity="center"
                        android:background="@null"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:inputType="textCapCharacters"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:maxLength="13"
                        android:maxLines="1" />

                </LinearLayout>

                <Button
                    android:id="@+id/redeemKeyButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/btn_redeem_key"
                    android:textAllCaps="true"
                    android:letterSpacing="0.02"
                    android:backgroundTint="@color/vg_green"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:cornerRadius="16dp" />

                <ProgressBar
                    android:id="@+id/redeemProgressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_gravity="center_horizontal"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>

    <include layout="@layout/bottom_nav_bar" />

</FrameLayout>
