<?xml version="1.0" encoding="utf-8"?>
<!--
    Increase Contact Limit - merged screen. Replaces the two separate
    destinations activity_grow_your_views.xml and activity_upgrade_plan.xml,
    which both existed to do the same underlying thing (raise the user's
    contact limit) via two different mechanisms:
      - referral milestones (campaign cards + share button)
      - key code redemption

    Structure: gradient header, then one shared limit card (uses the same
    3-source breakdown - Free plan / Unlocked group / Referral bonus - as
    the dashboard's limitBreakdownBlock, per updateLimitMeter() in
    MainMenuActivity.kt) that stays fixed regardless of which tab is
    active, then a two-tab switcher below it:
      - "Referral rewards" (former activity_grow_your_views.xml content)
      - "Redeem a key" (former activity_upgrade_plan.xml content)

    Only one tab's content is visible at a time; both panels are inflated
    up front and toggled via visibility in IncreaseLimitActivity, so
    switching tabs never re-fetches data that's already loaded.
-->
<!--
    Root is a FrameLayout so the bottom nav bar can float over the
    content as a rounded pill (see bottom_nav_bar.xml) instead of
    sitting in-flow as a full-width bar.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/apk/res-android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/stats_card_fill">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Green gradient header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/header_gradient"
        android:paddingTop="48dp"
        android:paddingBottom="28dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_increase_limit"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:fontFamily="@font/baloo2" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/subtitle_increase_limit"
            android:textSize="13sp"
            android:textColor="#DCF5E8" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="88dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="28dp">

            <!-- ============ TAB SWITCHER (segmented control) ============
                 Track uses its own dedicated fill (tab_track_fill) rather
                 than the card backgrounds used elsewhere, so the inactive
                 tab (fully transparent) always shows real contrast against
                 the track instead of blending into a white/near-white card. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/tab_track_background"
                android:padding="4dp"
                android:layout_marginBottom="20dp">

                <Button
                    android:id="@+id/tabReferralButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="@string/tab_referral_rewards"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:backgroundTint="@android:color/transparent"
                    android:textColor="@color/text_muted"
                    app:cornerRadius="12dp"
                    app:elevation="0dp"
                    app:rippleColor="@color/vg_green_tint"
                    android:stateListAnimator="@null"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <Button
                    android:id="@+id/tabKeyButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="@string/tab_redeem_key"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:backgroundTint="@android:color/transparent"
                    android:textColor="@color/text_muted"
                    app:cornerRadius="12dp"
                    app:elevation="0dp"
                    app:rippleColor="@color/vg_green_tint"
                    android:stateListAnimator="@null"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

            </LinearLayout>

            <!-- ============ REFERRAL REWARDS PANEL ============ -->
            <LinearLayout
                android:id="@+id/referralPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- My Referral Code - same block/logic as ProfileActivity,
                     the user's own WhatsApp number acts as their referral
                     code, shown here too so people don't have to leave this
                     screen to find it while referring friends. -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_label_my_referral_code"
                    android:textSize="11sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.05"
                    android:textColor="@color/text_muted"
                    android:gravity="center" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/referral_code_background"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/myReferralCodeText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/vg_green"
                        android:letterSpacing="0.03"
                        tools:text="08018485545" />

                    <Button
                        android:id="@+id/copyReferralCodeButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/btn_copy"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:backgroundTint="@color/vg_green"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:cornerRadius="16dp" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="20dp"
                    android:text="@string/get_viewers_referral_code_hint"
                    android:textSize="12sp"
                    android:textColor="@color/text_muted"
                    android:gravity="center" />

                <Button
                    android:id="@+id/shareInviteButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="20dp"
                    android:text="@string/btn_share_invite_link"
                    android:textAllCaps="true"
                    android:letterSpacing="0.02"
                    android:backgroundTint="@color/vg_green"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_share"
                    app:iconTint="@color/white"
                    app:iconGravity="textStart"
                    app:cornerRadius="16dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_earn_more_views"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/vg_dark"
                    android:gravity="center"
                    android:layout_marginBottom="10dp" />

                <ProgressBar
                    android:id="@+id/campaignsProgressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="12dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/campaignsEmptyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="24dp"
                    android:gravity="center"
                    android:textColor="@color/text_muted"
                    android:visibility="gone" />

                <!-- Campaign cards inserted at runtime, one per active
                     campaign - see IncreaseLimitActivity.renderCampaignCards(). -->
                <LinearLayout
                    android:id="@+id/campaignCardsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/noCampaignsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="24dp"
                    android:gravity="center"
                    android:textSize="13sp"
                    android:textColor="@color/text_muted"
                    android:text="@string/empty_no_active_campaigns"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- ============ REDEEM A KEY PANEL ============ -->
            <LinearLayout
                android:id="@+id/keyPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/upgradeSubtitleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/upgrade_plan_coming_soon"
                    android:textSize="14.5sp"
                    android:lineSpacingMultiplier="1.3"
                    android:textColor="@color/text_muted"
                    android:gravity="center"
                    android:layout_marginBottom="20dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_background"
                    android:padding="4dp"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxBackgroundMode="none"
                        app:hintTextColor="@color/vg_green"
                        app:hintEnabled="false"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/keyCodeInput"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:hint="@string/hint_key_code"
                            android:gravity="center"
                            android:inputType="textCapCharacters"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"
                            android:maxLength="13"
                            android:maxLines="1" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <Button
                    android:id="@+id/redeemKeyButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/btn_redeem_key"
                    android:textAllCaps="true"
                    android:letterSpacing="0.02"
                    android:backgroundTint="@color/vg_green"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:cornerRadius="16dp" />

                <Button
                    android:id="@+id/noCodeContactUsButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/btn_no_code_contact_us"
                    android:textAllCaps="true"
                    android:letterSpacing="0.02"
                    android:textStyle="bold"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:strokeColor="@color/primary_light"
                    android:textColor="@color/primary_light"
                    app:icon="@drawable/ic_chat"
                    app:iconTint="@color/primary_light"
                    app:iconGravity="textStart"
                    app:cornerRadius="16dp" />

                <ProgressBar
                    android:id="@+id/redeemProgressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_gravity="center_horizontal"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>

    <include layout="@layout/bottom_nav_bar" />

</FrameLayout>
