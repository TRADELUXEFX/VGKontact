<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/stats_card_fill">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/header_gradient"
        android:paddingTop="48dp"
        android:paddingBottom="36dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_notification_settings"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/white" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CHECK FREQUENCY"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/text_muted"
                android:letterSpacing="0.08"
                android:gravity="center"
                android:paddingBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/notification_frequency_desc"
                android:textSize="13sp"
                android:textColor="@color/vg_dark"
                android:paddingBottom="20dp"
                android:gravity="center" />

            <TextView
                android:id="@+id/frequencySummaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/freq_summary_pill_background"
                android:padding="16dp"
                android:textSize="15sp"
                android:textColor="@color/vg_green_dark"
                android:gravity="center"
                android:layout_marginBottom="18dp"
                android:text="Notifications sent every 24 hours" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:id="@+id/tile1Hour"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/freq_tile_default_background"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tile1HourValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/vg_dark" />

                    <TextView
                        android:id="@+id/tile1HourLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="hour"
                        android:textSize="12sp"
                        android:textColor="@color/text_muted" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tile6Hours"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/freq_tile_default_background"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tile6HoursValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="6"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/vg_dark" />

                    <TextView
                        android:id="@+id/tile6HoursLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="hours"
                        android:textSize="12sp"
                        android:textColor="@color/text_muted" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="18dp">

                <LinearLayout
                    android:id="@+id/tile12Hours"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/freq_tile_default_background"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tile12HoursValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/vg_dark" />

                    <TextView
                        android:id="@+id/tile12HoursLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="hours"
                        android:textSize="12sp"
                        android:textColor="@color/text_muted" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tile24Hours"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/freq_tile_selected_background"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tile24HoursValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="24"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/vg_green_dark" />

                    <TextView
                        android:id="@+id/tile24HoursLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="hours"
                        android:textSize="12sp"
                        android:textColor="@color/vg_green_dark" />

                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/stats_card_border"
                android:layout_marginBottom="18dp" />

            <Button
                android:id="@+id/saveFrequencyButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/btn_save"
                android:backgroundTint="@color/vg_green"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:cornerRadius="26dp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
