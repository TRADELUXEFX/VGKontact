<?xml version="1.0" encoding="utf-8"?>
<!--
    Repost & Earn screen. Same structure as activity_history.xml:
    green gradient header with a segmented tab switcher, then a scroll
    area of card_background cards.

    Two panels share the scroll area and are toggled by the header tabs
    (RepostActivity.showTab):
      - myStreakPanel: stats rows + repost button, dismissible task guide,
        milestones
      - leaderboardPanel: ranked list

    No bottom nav on this screen (it is reached from the floating
    Repost button, not a nav tab), so scroll padding is smaller than on
    the nav screens.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/stats_card_fill">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/stats_card_fill">

    <!-- ============ HEADER ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/header_gradient"
        android:paddingTop="48dp"
        android:paddingBottom="20dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/repostBackButton"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="start|center_vertical"
                android:rotation="180"
                android:src="@drawable/ic_arrow_forward"
                app:tint="@color/white"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/title_repost"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins" />

        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/repost_subtitle"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:alpha="0.9"
            android:textAlignment="center"
            android:fontFamily="@font/poppins" />

        <!-- Segmented tab switcher, same drawables as HistoryActivity -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/header_tab_track_background"
            android:padding="4dp"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/tabMyStreakButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/tab_my_streak"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="@android:color/transparent"
                android:textColor="@color/white"
                app:cornerRadius="12dp"
                app:elevation="0dp"
                app:rippleColor="@color/vg_green_tint"
                android:stateListAnimator="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <Button
                android:id="@+id/tabBoardButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="@string/tab_leaderboard"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="@android:color/transparent"
                android:textColor="@color/white"
                app:cornerRadius="12dp"
                app:elevation="0dp"
                app:rippleColor="@color/vg_green_tint"
                android:stateListAnimator="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

        </LinearLayout>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp">

            <!-- ================= MY STREAK PANEL ================= -->
            <LinearLayout
                android:id="@+id/myStreakPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Stats card: 4 plain rows + the action button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_background"
                    android:padding="18dp">

                    <!-- Today's repost -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/repost_row_today"
                            android:textSize="16sp"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/todayStatusText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/vg_red"
                            tools:text="Pending" />

                    </LinearLayout>

                    <!-- Current streak -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/repost_row_current_streak"
                            android:textSize="16sp"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/streakNumberText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/vg_dark"
                            tools:text="7 days" />

                    </LinearLayout>

                    <!-- Best streak -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/repost_row_best_streak"
                            android:textSize="16sp"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/bestStreakText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/vg_dark"
                            tools:text="11 days" />

                    </LinearLayout>

                    <!-- Total reposts -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/repost_row_total"
                            android:textSize="16sp"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/totalRepostsText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/vg_dark"
                            tools:text="42" />

                    </LinearLayout>

                    <!-- Action button. Red while today is pending,
                         soft green once done (RepostActivity.renderRepostButton). -->
                    <Button
                        android:id="@+id/repostNowButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="14dp"
                        android:text="@string/btn_repost_now"
                        android:textAllCaps="false"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/vg_red"
                        android:textColor="@color/white"
                        app:icon="@drawable/ic_repost"
                        app:iconGravity="textStart"
                        app:iconPadding="10dp"
                        app:iconSize="22dp"
                        app:iconTint="@color/white"
                        app:cornerRadius="28dp" />

                </LinearLayout>

                <!-- Today's task guide: visible by default, with a cancel (X)
                     in the corner. Tapping X hides it and reveals the dashed
                     "Show today's task guide" button below; tapping that
                     brings it back. Remembered via RepostPrefs. -->
                <FrameLayout
                    android:id="@+id/taskGuideCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/card_background">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="28dp"
                            android:text="@string/repost_todays_task"
                            android:textSize="11sp"
                            android:textAllCaps="true"
                            android:letterSpacing="0.05"
                            android:textColor="@color/text_muted" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/repost_step_1"
                            android:textSize="13sp"
                            android:lineSpacingMultiplier="1.3"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/repost_step_2"
                            android:textSize="13sp"
                            android:lineSpacingMultiplier="1.3"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/repost_step_3"
                            android:textSize="13sp"
                            android:lineSpacingMultiplier="1.3"
                            android:textColor="@color/text_secondary" />

                    </LinearLayout>

                    <!-- Cancel (X). 40dp touch target around a 14dp glyph. -->
                    <ImageView
                        android:id="@+id/taskGuideClose"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="6dp"
                        android:layout_marginEnd="6dp"
                        android:padding="13dp"
                        android:src="@drawable/ic_close_small"
                        app:tint="@color/text_muted"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="@string/repost_hide_guide" />

                </FrameLayout>

                <!-- Shown only after the guide has been hidden -->
                <TextView
                    android:id="@+id/taskGuideRestore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/repost_guide_toggle_background"
                    android:gravity="center"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:text="@string/repost_show_guide"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_muted"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone" />

                <!-- Milestones card (unchanged) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_background"
                    android:padding="18dp"
                    android:layout_marginTop="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/repost_milestones"
                            android:textSize="11sp"
                            android:textAllCaps="true"
                            android:letterSpacing="0.05"
                            android:textColor="@color/text_muted" />

                        <TextView
                            android:id="@+id/nextMilestonePill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/freq_summary_pill_background"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/vg_green_dark"
                            tools:text="3 days to go" />

                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/milestoneProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="14dp"
                        android:max="100"
                        android:progressDrawable="@drawable/limit_meter_progress" />

                    <!-- 4 milestone tiles, filled programmatically -->
                    <LinearLayout
                        android:id="@+id/milestoneRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />

                </LinearLayout>

            </LinearLayout>

            <!-- ================= LEADERBOARD PANEL ================= -->
            <LinearLayout
                android:id="@+id/leaderboardPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_background"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/repost_col_rank_number"
                            android:textSize="11sp"
                            android:textAllCaps="true"
                            android:letterSpacing="0.05"
                            android:textColor="@color/text_muted" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/repost_col_reposts"
                            android:textSize="11sp"
                            android:textAllCaps="true"
                            android:letterSpacing="0.05"
                            android:textColor="@color/text_muted" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/stats_card_border" />


                    <LinearLayout
                        android:id="@+id/boardListContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />

                    <HorizontalScrollView
                        android:id="@+id/boardPagerScroll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:scrollbars="none"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/boardPagerContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center" />

                    </HorizontalScrollView>

                    <TextView
                        android:id="@+id/boardNoteText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="16dp"
                        android:gravity="center"
                        android:textSize="12sp"
                        android:lineSpacingMultiplier="1.3"
                        android:textColor="@color/text_muted"
                        android:visibility="gone" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>

    <include layout="@layout/view_loading_overlay" />

</FrameLayout>
