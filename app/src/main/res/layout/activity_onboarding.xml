<!-- ===================== FORM SCREEN ===================== -->
    <LinearLayout
        android:id="@+id/formContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/white"
        android:visibility="gone">

        <!-- ==== GREEN HEADER ==== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@color/vg_green"
            android:paddingTop="56dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingBottom="32dp">

            <ImageView
                android:id="@+id/formBackButton"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="start"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/white"
                android:layout_marginBottom="20dp"
                android:padding="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VGKONTACT"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:textColor="@color/white" />

        </LinearLayout>

        <!-- ==== WHITE BODY ==== -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:paddingTop="32dp">

                <!-- ==== Field 01: WhatsApp number (required) ==== -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="INPUT WHATSAPP NUMBER"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.03"
                    android:gravity="center"
                    android:textColor="@color/vg_dark"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_whatsapp"
                    android:textColorHint="@color/text_muted"
                    app:hintTextColor="@color/vg_green_dark"
                    app:boxBackgroundMode="none"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/whatsappInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ledger_field_underline_active"
                        android:inputType="phone"
                        android:maxLength="11"
                        android:textSize="15sp"
                        android:textColor="@color/vg_dark"
                        android:textColorHint="@color/text_muted"
                        android:includeFontPadding="false"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="10dp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- ==== Field 02: Referral number (optional) ==== -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="REFERRAL NUMBER (OPTIONAL)"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.03"
                    android:gravity="center"
                    android:textColor="@color/vg_dark"
                    android:layout_marginTop="26dp"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_referral"
                    android:textColorHint="@color/text_muted"
                    app:hintTextColor="@color/vg_green_dark"
                    app:boxBackgroundMode="none"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/referralInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ledger_field_underline"
                        android:inputType="phone"
                        android:maxLength="11"
                        android:textSize="15sp"
                        android:textColor="@color/vg_dark"
                        android:textColorHint="@color/text_muted"
                        android:includeFontPadding="false"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="10dp" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="28dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="56dp">

                <Button
                    android:id="@+id/continueButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/btn_continue"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/vg_green"
                    android:textColor="@color/white"
                    app:cornerRadius="14dp" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/white"
                    android:visibility="gone" />

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>
