<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- ===================== FORM SCREEN ===================== -->
    <LinearLayout
        android:id="@+id/formContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/white"
        android:visibility="visible">

        <!-- ==== GREEN HEADER ==== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@color/vg_green"
            android:paddingTop="56dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_lead"
                android:textSize="15sp"
                android:textStyle="normal"
                android:alpha="0.92"
                android:textColor="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_hook"
                android:textSize="26sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"
                android:textColor="@color/white" />

        </LinearLayout>

        <!-- ==== WHITE BODY ==== -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:paddingTop="32dp">

                <!-- ==== Field 01: WhatsApp number (required) ==== -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="INPUT WHATSAPP NUMBER"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.03"
                    android:gravity="center"
                    android:textColor="@color/vg_dark"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_whatsapp"
                    android:textColorHint="@color/text_muted"
                    app:hintTextColor="@color/vg_green_dark"
                    app:boxBackgroundMode="outline"
                    app:boxBackgroundColor="@color/vg_field_bg"
                    app:boxStrokeColor="@color/vg_green"
                    app:boxStrokeWidth="1.5dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusBottomEnd="14dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/whatsappInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:inputType="phone"
                        android:maxLength="13"
                        android:textSize="15sp"
                        android:textColor="@color/vg_dark"
                        android:textColorHint="@color/text_muted"
                        android:includeFontPadding="false"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- ==== Field 02: Referral number (optional) ==== -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="REFERRAL NUMBER (OPTIONAL)"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.03"
                    android:gravity="center"
                    android:textColor="@color/vg_dark"
                    android:layout_marginTop="26dp"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_referral"
                    android:textColorHint="@color/text_muted"
                    app:hintTextColor="@color/vg_green_dark"
                    app:boxBackgroundMode="outline"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/vg_field_stroke_muted"
                    app:boxStrokeWidth="1.5dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusBottomEnd="14dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/referralInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:inputType="phone"
                        android:maxLength="13"
                        android:textSize="15sp"
                        android:textColor="@color/vg_dark"
                        android:textColorHint="@color/text_muted"
                        android:includeFontPadding="false"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="28dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="56dp">

                <Button
                    android:id="@+id/continueButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/btn_continue"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/vg_green"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:drawableEnd="@drawable/ic_arrow_forward"
                    android:drawablePadding="8dp"
                    app:cornerRadius="14dp" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/white"
                    android:visibility="gone" />

            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_credit"
                android:textSize="12sp"
                android:textColor="@color/text_muted"
                android:gravity="center"
                android:layout_marginTop="14dp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
