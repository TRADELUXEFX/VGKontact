<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- ===================== SLIDES CONTAINER ===================== -->
    <LinearLayout
        android:id="@+id/slidesContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="20dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/progressSeg1"
                    android:layout_width="20dp"
                    android:layout_height="3dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/progress_segment_active" />

                <View
                    android:id="@+id/progressSeg2"
                    android:layout_width="20dp"
                    android:layout_height="3dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/progress_segment_inactive" />

                <View
                    android:id="@+id/progressSeg3"
                    android:layout_width="20dp"
                    android:layout_height="3dp"
                    android:background="@drawable/progress_segment_inactive" />

            </LinearLayout>

            <TextView
                android:id="@+id/skipButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Skip"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_muted"
                android:padding="8dp" />

        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- SLIDE 1 -->
            <LinearLayout
                android:id="@+id/slide1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingStart="36dp"
                android:paddingEnd="36dp"
                android:visibility="visible">

                <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_launcher"
                    android:layout_marginBottom="32dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Join the Kontact List"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/vg_dark"
                    android:gravity="center"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enter your WhatsApp number to join a list of other Viewgrow kontacts."
                    android:textSize="14sp"
                    android:textColor="@color/text_muted"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.4" />

                <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

            </LinearLayout>

            <!-- SLIDE 2 -->
            <LinearLayout
                android:id="@+id/slide2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingStart="36dp"
                android:paddingEnd="36dp"
                android:visibility="gone">

                <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_launcher"
                    android:layout_marginBottom="32dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Save Your Kontacts"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/vg_dark"
                    android:gravity="center"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="We add the numbers on your Viewgrow list to your phone, so you can connect with them on WhatsApp."
                    android:textSize="14sp"
                    android:textColor="@color/text_muted"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.4" />

                <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

            </LinearLayout>

            <!-- SLIDE 3 -->
            <LinearLayout
                android:id="@+id/slide3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingStart="36dp"
                android:paddingEnd="36dp"
                android:visibility="gone">

                <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_launcher"
                    android:layout_marginBottom="32dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="See More Status Updates"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/vg_dark"
                    android:gravity="center"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Once you're saved in each other's contacts, you can see each other's WhatsApp Status updates."
                    android:textSize="14sp"
                    android:textColor="@color/text_muted"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.4" />

                <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

            </LinearLayout>

        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="32dp">

            <TextView
                android:id="@+id/slideCounter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="1 / 3"
                android:textSize="13sp"
                android:textColor="@color/text_muted" />

            <FrameLayout
                android:id="@+id/prevButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/card_background"
                android:visibility="invisible"
                android:contentDescription="Previous">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_chevron_left"
                    app:tint="@color/vg_dark" />

            </FrameLayout>

            <Button
                android:id="@+id/nextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:text="Next"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:backgroundTint="@color/vg_green"
                android:textColor="@color/white"
                app:cornerRadius="24dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- ===================== FORM SCREEN ===================== -->
    <LinearLayout
        android:id="@+id/formContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/white"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="56dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/formBackButton"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/vg_dark"
                android:layout_marginBottom="28dp"
                android:padding="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter your number"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/vg_dark"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This is the number we'll place in a Kontact group and sync to your phone"
                android:textSize="13.5sp"
                android:textColor="@color/text_muted"
                android:lineSpacingMultiplier="1.4" />

        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:paddingTop="24dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_whatsapp"
                    android:textColorHint="@color/vg_green"
                    app:hintTextColor="@color/vg_green"
                    app:boxStrokeColor="@color/vg_green"
                    app:boxBackgroundMode="none"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/whatsappInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone"
                        android:maxLength="11"
                        android:textSize="16sp"
                        android:textColor="@color/vg_dark"
                        android:textColorHint="@color/text_muted"
                        android:includeFontPadding="false"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:hint="@string/hint_referral"
                    android:textColorHint="@color/text_muted"
                    app:hintTextColor="@color/vg_green"
                    app:boxStrokeColor="@color/stats_card_border"
                    app:boxBackgroundMode="none"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/referralInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone"
                        android:maxLength="11"
                        android:textSize="16sp"
                        android:textColor="@color/vg_dark"
                        android:textColorHint="@color/text_muted"
                        android:includeFontPadding="false"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="28dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="56dp">

                <Button
                    android:id="@+id/continueButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/btn_continue"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/vg_green"
                    android:textColor="@color/white"
                    app:cornerRadius="28dp" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/white"
                    android:visibility="gone" />

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
