<?xml version="1.0" encoding="utf-8"?>
<!--
    This screen has no direct equivalent in vgkontact_groups_ui_preview.html
    (the reference only covers the main dashboard). It's restyled here using
    the same tokens the dashboard now uses - green gradient header, 16dp
    corner radii, card-style input - purely so it doesn't feel like a
    different, older app the moment a user taps "Join More Groups" from the
    dashboard.

    Title/subtitle are always the generic "enter your code" copy -
    UpgradePlanActivity no longer swaps in group-specific text, since the
    app doesn't let users see or pick a specific group ID (that's an
    admin-only decision via keys.groups_unlock).
    A "Don't have a code? Contact Us" button is included here too, so a
    user who lands here without a code still has a way out.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/apk/res-android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/stats_card_fill"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/header_gradient"
            android:paddingTop="48dp"
            android:paddingBottom="32dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:gravity="center">

            <TextView
                android:id="@+id/upgradeTitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_upgrade_plan"
                android:textSize="21sp"
                android:textStyle="bold"
                android:fontFamily="@font/baloo2"
                android:textColor="@color/white" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="top"
            android:padding="24dp">

            <TextView
                android:id="@+id/upgradeSubtitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/upgrade_plan_coming_soon"
                android:textSize="14.5sp"
                android:lineSpacingMultiplier="1.3"
                android:textColor="@color/text_muted"
                android:gravity="center"
                android:layout_marginBottom="22dp" />

            <!-- "Your Current Limit" reminder card - shows the same
                 syncedToPhone / contactLimit numbers as the dashboard
                 meter, loaded fresh here via SheetSync.fetchImportStats()
                 (see UpgradePlanActivity.loadCurrentLimit()) so it's
                 accurate no matter how the user got to this screen. -->
            <LinearLayout
                android:id="@+id/currentLimitCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="20dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/current_limit_label"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.05"
                    android:textColor="@color/text_muted" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal"
                    android:gravity="bottom">

                    <TextView
                        android:id="@+id/currentLimitNumberText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/vg_dark"
                        android:fontFamily="@font/baloo2"
                        tools:text="15" />

                    <TextView
                        android:id="@+id/currentLimitOfText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_muted"
                        tools:text="/ 250 contacts" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/current_limit_sub"
                    android:textSize="12.5sp"
                    android:lineSpacingMultiplier="1.4"
                    android:textColor="@color/text_muted" />

                <!-- Limit breakdown - same 3-row pattern as the dashboard's
                     limitBreakdownBlock (Free plan / Unlocked group /
                     Referral bonus), populated by
                     UpgradePlanActivity.loadCurrentLimit(). Hidden entirely
                     when the values aren't known yet (-1) or there's no
                     bonus to show, same rule as the dashboard. -->
                <LinearLayout
                    android:id="@+id/limitBreakdownBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="14dp"
                    android:paddingTop="12dp"
                    android:background="@drawable/limit_breakdown_divider"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_free_plan"
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/limitBaseText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textColor="@color/vg_dark"
                            tools:text="100" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/limitUnlockedRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_unlocked_group"
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/limitUnlockedText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textColor="@color/vg_dark"
                            tools:text="+100" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/limitBonusRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_referral_bonus"
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/limitBonusText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textColor="@color/vg_green_dark"
                            tools:text="+20" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="4dp"
                android:layout_marginBottom="16dp">

                <EditText
                    android:id="@+id/keyCodeInput"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:hint="@string/hint_key_code"
                    android:textColorHint="@color/text_muted"
                    android:gravity="center"
                    android:background="@null"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:inputType="textCapCharacters"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:maxLength="13"
                    android:maxLines="1" />

            </LinearLayout>

            <Button
                android:id="@+id/redeemKeyButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/btn_redeem_key"
                android:textAllCaps="true"
                android:letterSpacing="0.02"
                android:backgroundTint="@color/vg_green"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:cornerRadius="16dp" />

            <Button
                android:id="@+id/noCodeContactUsButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="@string/btn_no_code_contact_us"
                android:textAllCaps="true"
                android:letterSpacing="0.02"
                android:textStyle="bold"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/primary_light"
                android:textColor="@color/primary_light"
                app:icon="@drawable/ic_chat"
                app:iconTint="@color/primary_light"
                app:iconGravity="textStart"
                app:cornerRadius="16dp" />

            <ProgressBar
                android:id="@+id/redeemProgressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_gravity="center_horizontal"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
