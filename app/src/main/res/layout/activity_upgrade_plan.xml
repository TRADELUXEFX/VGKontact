<?xml version="1.0" encoding="utf-8"?>
<!--
    This screen has no direct equivalent in vgkontact_groups_ui_preview.html
    (the reference only covers the main dashboard). It's restyled here using
    the same tokens the dashboard now uses - green gradient header, 16dp
    corner radii, card-style input - purely so it doesn't feel like a
    different, older app the moment a user taps "Join More Groups" from the
    dashboard. Nothing here was invented beyond applying the established
    look consistently.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/stats_card_fill">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/header_gradient"
        android:paddingTop="48dp"
        android:paddingBottom="32dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:gravity="center">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_add"
            android:background="@drawable/avatar_circle_background"
            app:tint="@color/vg_green" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/title_upgrade_plan"
            android:textSize="21sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/white" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="top"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/upgrade_plan_coming_soon"
            android:textSize="14.5sp"
            android:lineSpacingMultiplier="1.3"
            android:textColor="@color/text_muted"
            android:gravity="center"
            android:layout_marginBottom="22dp" />

        <!-- Card wrapper around the input, matching the rounded/bordered
             card style used elsewhere (card_background.xml), so the key
             field doesn't sit as a bare system-default box. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="4dp"
            android:layout_marginBottom="16dp">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxBackgroundMode="none"
                app:hintTextColor="@color/vg_green"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/keyCodeInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_key_code"
                    android:inputType="textCapCharacters"
                    android:textSize="15sp"
                    android:letterSpacing="0.05"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <Button
            android:id="@+id/redeemKeyButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/btn_redeem_key"
            android:textAllCaps="true"
            android:letterSpacing="0.02"
            android:backgroundTint="@color/vg_green"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:cornerRadius="16dp" />

        <ProgressBar
            android:id="@+id/redeemProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_gravity="center_horizontal"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
