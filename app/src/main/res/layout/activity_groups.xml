<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/stats_card_fill"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/header_gradient"
            android:paddingTop="56dp"
            android:paddingBottom="36dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_groups"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/white" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- One box: row-head, box-level search, then the two
                 collapsible sections (Your Groups / All Kontact Groups),
                 matching kontact_groups_onebox.html. Search is no longer
                 nested inside "All Kontact Groups" - it sits above both
                 sections and filters the full combined group list. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Kontact Groups"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/vg_dark"
                        android:fontFamily="@font/baloo2" />

                    <TextView
                        android:id="@+id/groupsCountText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11.5sp"
                        android:textColor="@color/text_muted"
                        tools:text="9 groups \u00B7 5 joined" />

                </LinearLayout>

                <EditText
                    android:id="@+id/groupSearchInput"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:hint="Search groups by ID..."
                    android:inputType="number"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:background="@drawable/rect_box_background"
                    android:textSize="13sp"
                    android:textColor="@color/vg_dark"
                    android:textColorHint="@color/text_muted"
                    android:fontFamily="@font/manrope"
                    android:imeOptions="actionDone"
                    android:layout_marginBottom="14dp" />

                <!-- Default view: two independently-collapsible sections
                     inside one bordered box. -->
                <LinearLayout
                    android:id="@+id/sectionsView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/rect_box_background">

                        <!-- Your Groups section -->
                        <FrameLayout
                            android:id="@+id/yourGroupsHeaderContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <LinearLayout
                            android:id="@+id/yourGroupsBody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@color/stats_card_fill"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="14dp"
                            android:visibility="gone">

                            <LinearLayout
                                android:id="@+id/yourGroupsRows"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:showDividers="middle"
                                android:divider="@drawable/group_row_spacer" />

                        </LinearLayout>

                        <!-- All Kontact Groups section -->
                        <FrameLayout
                            android:id="@+id/allGroupsHeaderContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/rect_section_divider_background" />

                        <LinearLayout
                            android:id="@+id/allGroupsBody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@drawable/rect_section_body_bottom_background"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="14dp"
                            android:visibility="gone">

                            <LinearLayout
                                android:id="@+id/allGroupsRows"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:showDividers="middle"
                                android:divider="@drawable/group_row_spacer" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <!-- Search-active view: one flat results list pulled from
                     the full combined group set (joined + not joined). -->
                <LinearLayout
                    android:id="@+id/resultsView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/resultsList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:showDividers="middle"
                        android:divider="@drawable/group_row_spacer" />

                    <TextView
                        android:id="@+id/noResultsText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textSize="12.5sp"
                        android:textColor="@color/text_muted"
                        android:paddingTop="20dp"
                        android:paddingBottom="20dp"
                        android:visibility="gone"
                        tools:text="No groups match \u201c7\u201d" />

                </LinearLayout>

                <TextView
                    android:id="@+id/allGroupsErrorText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Couldn\u2019t load groups. Check your connection and reopen this screen."
                    android:textSize="12.5sp"
                    android:textColor="@color/text_muted"
                    android:visibility="gone"
                    android:layout_marginTop="12dp" />

            </LinearLayout>

            <!-- Action buttons sit below the card, same pattern Profile
                 uses for its Contact Us button - not crammed inside it. -->
            <Button
                android:id="@+id/joinGroupsButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:text="@string/btn_join_groups"
                android:textAllCaps="true"
                android:letterSpacing="0.02"
                android:backgroundTint="@color/vg_green"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:icon="@drawable/ic_add"
                app:iconTint="@color/white"
                app:iconGravity="textStart"
                app:cornerRadius="16dp" />

            <Button
                android:id="@+id/noCodeContactUsButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="@string/btn_no_code_contact_us"
                android:textAllCaps="true"
                android:letterSpacing="0.02"
                android:textStyle="bold"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/primary_light"
                android:textColor="@color/primary_light"
                app:icon="@drawable/ic_chat"
                app:iconTint="@color/primary_light"
                app:iconGravity="textStart"
                app:cornerRadius="16dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
