<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/stats_card_fill"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/header_gradient"
            android:paddingTop="56dp"
            android:paddingBottom="36dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_groups"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/white" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Everything below now sits inside one white card, matching
                 the Profile screen's card_background container, instead of
                 loose text/tiles floating directly on the green page
                 background. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Your Kontact Groups"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/vg_dark"
                    android:fontFamily="@font/baloo2" />

                <TextView
                    android:id="@+id/groupsCountText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11.5sp"
                    android:textColor="@color/text_muted"
                    tools:text="1 joined" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/stats_tile_accent_background"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="13dp"
                android:paddingBottom="13dp"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:background="@drawable/check_circle_background"
                    android:padding="3.5dp"
                    android:src="@drawable/ic_check"
                    app:tint="@color/vg_green_dark" />

                <TextView
                    android:id="@+id/joinedGroupsTitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/vg_green_dark"
                    android:fontFamily="@font/baloo2"
                    tools:text="1 Group" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="\u00B7"
                    android:textSize="13sp"
                    android:textColor="@color/vg_green_dark" />

                <TextView
                    android:id="@+id/joinedGroupsMetaText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:textSize="13sp"
                    android:textColor="@color/vg_green_dark"
                    android:gravity="end"
                    android:textAlignment="viewEnd"
                    tools:text="4 kontacts" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/allGroupsTitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All Kontact Groups"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/vg_dark"
                    android:fontFamily="@font/baloo2"
                    android:layout_marginBottom="10dp" />

                <EditText
                    android:id="@+id/groupSearchInput"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Search groups by ID..."
                    android:inputType="text"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:background="@drawable/card_background"
                    android:textSize="14sp"
                    android:textColor="@color/vg_dark"
                    android:textColorHint="@color/text_muted"
                    android:fontFamily="@font/manrope"
                    android:imeOptions="actionDone" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/allGroupsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <HorizontalScrollView
                android:id="@+id/groupsPagerScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/groupsPagerContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center" />

            </HorizontalScrollView>

            <TextView
                android:id="@+id/allGroupsErrorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Couldn\u2019t load groups. Check your connection and reopen this screen."
                android:textSize="12.5sp"
                android:textColor="@color/text_muted"
                android:visibility="gone"
                android:layout_marginTop="12dp" />

            </LinearLayout>

            <!-- Action buttons sit below the card, same pattern Profile
                 uses for its Contact Us button - not crammed inside it. -->
            <Button
                android:id="@+id/joinGroupsButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:text="@string/btn_join_groups"
                android:textAllCaps="true"
                android:letterSpacing="0.02"
                android:backgroundTint="@color/vg_green"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:icon="@drawable/ic_add"
                app:iconTint="@color/white"
                app:iconGravity="textStart"
                app:cornerRadius="16dp" />

            <Button
                android:id="@+id/noCodeContactUsButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="@string/btn_no_code_contact_us"
                android:textAllCaps="true"
                android:letterSpacing="0.02"
                android:textStyle="bold"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/primary_light"
                android:textColor="@color/primary_light"
                app:icon="@drawable/ic_chat"
                app:iconTint="@color/primary_light"
                app:iconGravity="textStart"
                app:cornerRadius="16dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
