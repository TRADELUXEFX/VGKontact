<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/stats_card_fill"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/header_gradient"
            android:paddingTop="56dp"
            android:paddingBottom="36dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_groups"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/white" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="KONTACT GROUPS"
                    android:textSize="11sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.05"
                    android:textColor="@color/text_muted" />

                <TextView
                    android:id="@+id/groupsCountText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/vg_dark"
                    android:paddingTop="2dp"
                    android:paddingBottom="16dp"
                    tools:text="10 groups \u00B7 1 joined" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/stats_card_border"
                    android:layout_marginBottom="16dp" />

                <EditText
                    android:id="@+id/groupSearchInput"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:hint="Search groups by ID..."
                    android:inputType="number"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:background="@drawable/referral_code_background"
                    android:textSize="13sp"
                    android:textColor="@color/vg_dark"
                    android:textColorHint="@color/text_muted"
                    android:fontFamily="@font/manrope"
                    android:imeOptions="actionDone"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:id="@+id/sectionsView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/tab_switch_background"
                        android:padding="3dp"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:id="@+id/yourGroupsTab"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="YOUR GROUPS"
                            android:textAllCaps="true"
                            android:letterSpacing="0.03"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/baloo2"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/allGroupsTab"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="ALL KONTACT GROUPS"
                            android:textAllCaps="true"
                            android:letterSpacing="0.03"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/baloo2"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/activeGroupsSubText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/text_muted"
                        android:paddingBottom="8dp"
                        tools:text="1 joined \u00B7 2 kontacts" />

                    <LinearLayout
                        android:id="@+id/activeGroupsRows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/activeGroupsEmptyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textSize="12.5sp"
                        android:textColor="@color/text_muted"
                        android:paddingTop="20dp"
                        android:paddingBottom="20dp"
                        android:visibility="gone"
                        tools:text="None joined yet" />

                    <HorizontalScrollView
                        android:id="@+id/groupsPagerScroll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:scrollbars="none"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/groupsPagerContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center" />

                    </HorizontalScrollView>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/resultsView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/resultsList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/noResultsText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textSize="12.5sp"
                        android:textColor="@color/text_muted"
                        android:paddingTop="20dp"
                        android:paddingBottom="20dp"
                        android:visibility="gone"
                        tools:text="No groups match \u201c7\u201d" />

                </LinearLayout>

                <TextView
                    android:id="@+id/allGroupsErrorText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Couldn\u2019t load groups. Check your connection and reopen this screen."
                    android:textSize="12.5sp"
                    android:textColor="@color/text_muted"
                    android:visibility="gone"
                    android:layout_marginTop="12dp" />

            </LinearLayout>

            <Button
                android:id="@+id/joinGroupsButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:text="@string/btn_join_groups"
                android:textAllCaps="true"
                android:letterSpacing="0.02"
                android:backgroundTint="@color/vg_green"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:icon="@drawable/ic_add"
                app:iconTint="@color/white"
                app:iconGravity="textStart"
                app:cornerRadius="16dp" />

            <Button
                android:id="@+id/noCodeContactUsButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="@string/btn_no_code_contact_us"
                android:textAllCaps="true"
                android:letterSpacing="0.02"
                android:textStyle="bold"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/primary_light"
                android:textColor="@color/primary_light"
                app:icon="@drawable/ic_chat"
                app:iconTint="@color/primary_light"
                app:iconGravity="textStart"
                app:cornerRadius="16dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
