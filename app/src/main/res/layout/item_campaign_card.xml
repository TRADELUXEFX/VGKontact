<?xml version="1.0" encoding="utf-8"?>
<!--
    One paid campaign's card - inflated once per active row in
    IncreaseLimitActivity.renderCampaignCards(). Copies card_background
    for the outer card (same drawable as every other card on this
    screen/app) so it sits visually identical to the contact-limit card
    above it. Pure listing + redirect: no progress, no claim state -
    the button just opens the campaign's destination link.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/apk/res-android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_background"
    android:padding="18dp"
    android:layout_marginBottom="12dp">

    <!-- Top row: requirements/description on the left, rate pill on
         the right (e.g. "₦500 per 1000 views"). Both come straight
         from the admin panel's campaign fields. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <TextView
            android:id="@+id/campaignDescriptionText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="15sp"
            android:textColor="@color/vg_dark"
            tools:text="Repost our status daily for 7 days" />

        <TextView
            android:id="@+id/campaignRewardBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="@drawable/reward_badge_background"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/vg_dark"
            tools:text="₦500 per 1000 views" />

    </LinearLayout>

    <Button
        android:id="@+id/campaignClaimButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/btn_campaign_interested"
        android:textAllCaps="true"
        android:letterSpacing="0.02"
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:backgroundTint="@color/vg_green"
        android:textColor="@color/white"
        app:cornerRadius="16dp" />

</LinearLayout>
