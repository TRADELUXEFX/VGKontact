<resources>
    <style name="Theme.VGKontact" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary Brand Colors -->
        <item name="colorPrimary">#25D366</item>
        <item name="colorPrimaryVariant">#128C7E</item>
        <item name="colorOnPrimary">#FFFFFF</item>

        <!-- Force Light Backgrounds and Text -->
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="android:textColorPrimary">#000000</item>
        <item name="android:textColorSecondary">#555555</item>

        <!-- Disable Force Dark Mode Engine -->
        <item name="android:forceDarkAllowed">false</item>

        <!-- App-wide font: Baloo 2, downloaded at runtime via Google Play
             Services font provider (see res/font/baloo2.xml). No font
             files are bundled into the APK. If a device has no Google
             Play Services, this falls back to the system default font
             automatically - no crash. -->
        <item name="android:fontFamily">@font/baloo2</item>
        <item name="fontFamily">@font/baloo2</item>
    </style>

    <!-- Missing Divider Style required by activity_history.xml -->
    <style name="MenuDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">#E0E0E0</item>
    </style>
</resources>
