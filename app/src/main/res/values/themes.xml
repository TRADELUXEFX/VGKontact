<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.VGKontact" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/vg_green</item>
        <item name="colorPrimaryDark">@color/vg_dark</item>
        <item name="colorAccent">@color/vg_green</item>
        <item name="android:windowBackground">@color/white</item>
    </style>

    <style name="MenuRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/vg_dark</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <style name="MenuDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/gray_light</item>
    </style>
</resources>
