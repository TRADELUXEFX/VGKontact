<resources>
    <style name="Theme.VGKontact" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary Brand Colors -->
        <item name="colorPrimary">#25D366</item>
        <item name="colorPrimaryVariant">#128C7E</item>
        <item name="colorOnPrimary">#FFFFFF</item>

        <!-- Force Light Backgrounds and Text -->
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="android:textColorPrimary">#000000</item>
        <item name="android:textColorSecondary">#555555</item>

        <!-- Disable Force Dark Mode Engine -->
        <item name="android:forceDarkAllowed">false</item>

        <!-- PopupMenu (e.g. the sync-frequency dropdown on the dashboard)
             otherwise falls back to this DayNight theme's dark popup
             styling on a device in system dark mode - everything else in
             this theme is deliberately forced light above, but popupTheme
             isn't inherited from android:textColorPrimary/windowBackground,
             so it needs its own explicit override to match. -->
        <item name="popupMenuStyle">@style/VGKontactPopupMenu</item>
        <item name="popupTheme">@style/ThemeOverlay.MaterialComponents.Light</item>

        <!-- App-wide font intentionally NOT set here.
             Baloo 2 is a downloadable font (Google Play Services Fonts
             provider - see res/font/baloo2.xml). Setting a downloadable
             font directly as the theme's fontFamily makes font
             resolution part of every single Activity's setContentView()
             inflate path - on any environment where the Play Services
             Fonts provider can't be reached synchronously (Secure
             Folder / work-profile GMS sandboxing, restricted or
             outdated Play Services, a slow/first-time provider query),
             that inflate throws and crashes the app on launch, on every
             screen. Not something "Clear cache" fixes, since the
             failure is the provider being unreachable, not corrupted
             local state.
             Baloo 2 is loaded asynchronously at runtime instead (see
             FontHelper.applyBaloo2Async), with the system default font
             as a guaranteed fallback if the provider ever fails. -->
    </style>

    <!-- Missing Divider Style required by activity_history.xml -->
    <style name="MenuDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">#E0E0E0</item>
    </style>

    <!-- Explicit light popup style for PopupMenu (see popupMenuStyle above)
         so dropdowns like the sync-frequency menu render with a white
         background and dark text regardless of system dark mode, matching
         the rest of this deliberately light-themed app. -->
    <style name="VGKontactPopupMenu" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@android:color/white</item>
    </style>

    <!-- Fully rounded (circular) crop for the header logo ImageView -
         50% corner size on a square view clips it into a circle. -->
    <style name="CircleImageShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
