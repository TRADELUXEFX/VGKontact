<?xml version="1.0" encoding="utf-8"?>
<!--
    Fade-through (Material pattern for sibling bottom-nav tabs), incoming
    half: waits for the outgoing screen to finish fading (90ms), then
    fades in with a slight scale-up from 92% to 100%. Because the two
    screens never overlap, there is no muddy ghosting at the midpoint.
    Paired with nav_tab_fade_out. Used explicitly by
    BottomNavHelper.navigateTo for the four tab switches only.
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/fast_out_slow_in">
    <alpha
        android:fromAlpha="0.0"
        android:toAlpha="1.0"
        android:startOffset="90"
        android:duration="210" />
    <scale
        android:fromXScale="0.92"
        android:toXScale="1.0"
        android:fromYScale="0.92"
        android:toYScale="1.0"
        android:pivotX="50%"
        android:pivotY="50%"
        android:startOffset="90"
        android:duration="210" />
</set>
