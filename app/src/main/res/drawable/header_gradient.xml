<?xml version="1.0" encoding="utf-8"?>
<!-- Vertical green -> green-dark header gradient. Runs strictly top-to-
     bottom (angle 270) so the entire top edge of the header is pure,
     uniform vg_green across its full width - this is what lets the flat
     vg_green status bar match seamlessly edge to edge, with no diagonal
     blending happening yet at that seam. The color still transitions
     down to vg_green_dark by the bottom of the header, just vertically
     instead of diagonally. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/vg_green"
        android:endColor="@color/vg_green_dark" />
</shape>
