<?xml version="1.0" encoding="utf-8"?>
<!-- Matches the UI reference's 135deg green -> green-dark header gradient.
     Android's "angle" is measured counter-clockwise from the positive
     x-axis in 45deg steps; 315 draws bottom-left -> top-right, which is
     the closest built-in match to the reference's CSS 135deg (top-left ->
     bottom-right) diagonal. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="@color/vg_green"
        android:endColor="@color/vg_green_dark" />
</shape>
