<?xml version="1.0" encoding="utf-8"?>
<!-- Base shape for the permission health banner. The fill color is swapped
     at runtime (amber for a soft warning, red for the blocking contacts
     warning) via GradientDrawable.setColor() in MainMenuActivity. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@color/warning_amber" />

    <corners android:radius="12dp" />

</shape>
