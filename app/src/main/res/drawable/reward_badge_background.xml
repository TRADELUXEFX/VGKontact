<?xml version="1.0" encoding="utf-8"?>
<!-- Filled pill background for the campaign reward badge (e.g. "+20 viewers"),
     top-right of item_campaign_card. Fully rounded corners so it reads as a
     pill rather than a rounded rect. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@color/vg_green_tint" />

    <corners android:radius="20dp" />

</shape>
