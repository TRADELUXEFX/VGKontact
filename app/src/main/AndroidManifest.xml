<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network permissions for Google Sheets / Apps Script synchronization -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Contact permissions for syncing -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />

    <!-- Notification permission (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Battery optimization exemption -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VGKontact">

        <!-- Main Launcher Activity -->
        <activity
            android:name=".OnboardingActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- One-time permission priming + loading screen, shown once right
             after registration, before the dashboard is ever reached -->
        <activity
            android:name=".PermissionSetupActivity"
            android:exported="false" />

        <activity
            android:name=".DeviceBlockedActivity"
            android:exported="false" />

        <activity
            android:name=".BannedActivity"
            android:exported="false" />

        <activity
            android:name=".DeviceUnverifiedActivity"
            android:exported="false" />

        <!-- Reachable proactively from the dashboard's "Recover Account"
             button - see RecoverAccountActivity doc comment. -->
        <activity
            android:name=".RecoverAccountActivity"
            android:exported="false" />

        <!-- Main Menu -->
        <activity
            android:name=".MainMenuActivity"
            android:exported="false" />

        <!-- History View -->
        <activity
            android:name=".HistoryActivity"
            android:exported="false" />

        <!-- Increase Contact Limit - merged screen (Referral rewards +
             Redeem a key tabs). Replaced GrowYourViewsActivity and
             UpgradePlanActivity as the entry point from the dashboard;
             both had already-deleted .kt files and zero live references,
             so their manifest entries were removed. -->
        <activity
            android:name=".IncreaseLimitActivity"
            android:exported="false" />

        <!-- Notification Settings -->
        <activity
            android:name=".NotificationSettingsActivity"
            android:exported="false" />

        <!-- Activity feed - opened from the dashboard bell -->
        <activity
            android:name=".ActivityLogActivity"
            android:exported="false" />

        <!-- Profile View -->
        <activity
            android:name=".ProfileActivity"
            android:exported="false" />

        <!-- Wallet - referral commission balance, withdraw and recent
             activity. Reached from the Wallet bottom-nav tab. It was
             missing from the manifest before, which made tapping the tab
             crash with ActivityNotFoundException. -->
        <activity
            android:name=".WalletActivity"
            android:exported="false" />

        <!-- Repost & Earn screen (streak + leaderboard) - opened from the
             floating Repost button on every screen. -->
        <activity
            android:name=".RepostActivity"
            android:exported="false" />

        <!-- Invisible trampoline launched by the daily repost
             notification - computes today's date live at tap time,
             then hands off to WhatsApp and closes itself. Transparent
             theme so it never visibly flashes a blank screen. -->
        <activity
            android:name=".RepostRedirectActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true" />

    </application>

</manifest>
