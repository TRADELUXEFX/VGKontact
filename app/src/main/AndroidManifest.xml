<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network permissions for Google Sheets / Apps Script synchronization -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Contact permissions for syncing -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />

    <!-- Notification permission (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Battery optimization exemption -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VGKontact">

        <!-- Main Launcher Activity -->
        <activity
            android:name=".OnboardingActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- One-time permission priming + loading screen, shown once right
             after registration, before the dashboard is ever reached -->
        <activity
            android:name=".PermissionSetupActivity"
            android:exported="false" />

        <!-- Phone OTP Verification -->
        <activity
            android:name=".PhoneVerificationActivity"
            android:exported="false" />

        <!-- Main Menu -->
        <activity
            android:name=".MainMenuActivity"
            android:exported="false" />

        <!-- History View -->
        <activity
            android:name=".HistoryActivity"
            android:exported="false" />

        <!-- Increase Contact Limit - merged screen (Referral rewards +
             Redeem a key tabs). Replaces GrowYourViewsActivity and
             UpgradePlanActivity as the entry point from the dashboard;
             both are left registered below, unused, until confirmed
             nothing else (deep links, notifications) targets them
             directly. -->
        <activity
            android:name=".IncreaseLimitActivity"
            android:exported="false" />

        <!-- Grow Your Views (deprecated - superseded by IncreaseLimitActivity) -->
        <activity
            android:name=".GrowYourViewsActivity"
            android:exported="false" />

        <!-- Notification Settings -->
        <activity
            android:name=".NotificationSettingsActivity"
            android:exported="false" />

        <!-- Profile View -->
        <activity
            android:name=".ProfileActivity"
            android:exported="false" />

        <!-- Upgrade Plan (deprecated - superseded by IncreaseLimitActivity) -->
        <activity
            android:name=".UpgradePlanActivity"
            android:exported="false" />

    </application>

</manifest>
